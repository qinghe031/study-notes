---
// 给自己的话 — one kraft-paper sticky, tape on top, handwriting, slight tilt.
// Flip through the rest with the small arrows. Editable in place; local-first.
import { STICKIES } from '../lib/site';
const seed = JSON.stringify(STICKIES);
const first = STICKIES[0];
---

<section id="stickies" class="sticky-wrap reveal" data-seed={seed}>
  <article id="sticky-card" class="sticky-card" data-color={first?.color || 'kraft'}>
    <span class="tape" aria-hidden="true"></span>
    <p class="sticky-eyebrow">给自己的话:</p>
    <p id="sticky-text" class="sticky-text" contenteditable="true" spellcheck="false">{first?.text || ''}</p>
    <footer class="sticky-foot">
      <span class="sticky-sign">—— 致自己</span>
      <span class="sticky-smile" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M8.5 14.5s1.3 1.5 3.5 1.5 3.5-1.5 3.5-1.5"/><path d="M9 10h.01M15 10h.01"/></svg>
      </span>
    </footer>
  </article>

  <div class="sticky-nav">
    <button type="button" id="sticky-prev" class="sticky-arrow" aria-label="上一张">‹</button>
    <span id="sticky-count" class="sticky-counter"></span>
    <button type="button" id="sticky-next" class="sticky-arrow" aria-label="下一张">›</button>
    <span class="mx-1 h-3 w-px bg-border"></span>
    <button type="button" id="sticky-add" class="sticky-tool" title="再贴一张">＋</button>
    <button type="button" id="sticky-del" class="sticky-tool" title="撕掉这张">✕</button>
  </div>
</section>

<style>
  .sticky-wrap { position: relative; }
  .sticky-card {
    position: relative;
    padding: 1.6rem 1.5rem 1.2rem;
    min-height: 12.5rem;
    background: var(--kraft);
    color: var(--kraft-ink);
    border-radius: 2px;
    transform: rotate(-1.4deg);
    box-shadow: 0 1px 2px rgba(47, 51, 55, 0.08), 0 18px 32px -18px rgba(47, 51, 55, 0.4);
    font-family: var(--font-hand);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sticky-card:hover { transform: rotate(0deg) translateY(-2px); }
  .tape {
    position: absolute; top: -0.75rem; left: 50%; width: 4.5rem; height: 1.5rem;
    transform: translateX(-50%) rotate(-2deg);
    background: var(--tape);
    border: 1px solid rgba(0, 0, 0, 0.05);
    backdrop-filter: blur(1px);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
  }
  .sticky-eyebrow { font-size: 0.88rem; opacity: 0.75; margin-bottom: 0.6rem; }
  .sticky-text { font-size: 0.98rem; line-height: 1.85; white-space: pre-line; min-height: 5em; outline: none; }
  .sticky-text:empty::before { content: '写一句给自己的话…'; opacity: 0.4; }
  .sticky-text:focus { box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--kraft-ink) 30%, transparent); }
  .sticky-foot { display: flex; justify-content: flex-end; align-items: center; gap: 0.6rem; margin-top: 0.8rem; opacity: 0.8; font-size: 0.88rem; }
  .sticky-smile { opacity: 0.7; }

  .sticky-nav { display: flex; align-items: center; justify-content: flex-end; gap: 0.25rem; margin-top: 0.9rem; padding-right: 0.25rem; }
  .sticky-arrow, .sticky-tool {
    width: 1.6rem; height: 1.6rem; border-radius: 999px; font-size: 0.9rem; line-height: 1;
    color: var(--muted-foreground); transition: color 0.15s, background-color 0.15s;
  }
  .sticky-arrow:hover, .sticky-tool:hover { color: var(--foreground); background: var(--muted); }
  .sticky-arrow:disabled { opacity: 0.3; pointer-events: none; }
  .sticky-counter { font-size: 0.7rem; color: var(--muted-foreground); min-width: 2rem; text-align: center; font-variant-numeric: tabular-nums; }
  .sticky-tool { font-size: 0.75rem; }
  @media (prefers-reduced-motion: reduce) { .sticky-card { transition: none; } }
</style>

<script>
  import { load, setStickies, seedMisc, uid } from '../lib/notebook';

  const root = document.getElementById('stickies')!;
  const text = document.getElementById('sticky-text') as HTMLElement;
  const counter = document.getElementById('sticky-count')!;
  const prev = document.getElementById('sticky-prev') as HTMLButtonElement;
  const next = document.getElementById('sticky-next') as HTMLButtonElement;
  let idx = 0;

  seedMisc(JSON.parse(root.dataset.seed || '[]'), []);

  function list() { return load().stickies; }
  function show(i: number) {
    const l = list();
    if (!l.length) { text.textContent = ''; counter.textContent = '0 / 0'; prev.disabled = next.disabled = true; return; }
    idx = Math.max(0, Math.min(i, l.length - 1));
    text.textContent = l[idx].text;
    counter.textContent = `${idx + 1} / ${l.length}`;
    prev.disabled = idx === 0; next.disabled = idx === l.length - 1;
  }
  function commit() {
    const l = list();
    if (!l[idx]) return;
    l[idx].text = text.textContent?.trim() || '';
    setStickies(l);
  }

  let t = 0;
  text.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(commit, 400); });
  text.addEventListener('blur', commit);
  text.addEventListener('keydown', (e) => { if (e.key === 'Escape') text.blur(); });
  prev.onclick = () => { commit(); show(idx - 1); };
  next.onclick = () => { commit(); show(idx + 1); };
  (document.getElementById('sticky-add') as HTMLButtonElement).onclick = () => {
    commit();
    const l = list(); l.push({ id: uid(), text: '', color: 'kraft', createdAt: Date.now() }); setStickies(l);
    show(l.length - 1); text.focus();
  };
  (document.getElementById('sticky-del') as HTMLButtonElement).onclick = () => {
    const l = list(); if (!l.length) return;
    if (!confirm('撕掉这张?')) return;
    l.splice(idx, 1); setStickies(l); show(Math.min(idx, l.length - 1));
  };
  show(0);
</script>
