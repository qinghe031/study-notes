---
import SidebarCard from './SidebarCard.astro';
import type { TocItem } from '../lib/content';

interface Props {
  headings: TocItem[];
}
const { headings } = Astro.props;
---

{
  headings.length > 0 && (
    <SidebarCard title="目录" class="toc">
      <nav>
        <ul class="space-y-0.5 text-sm">
          {headings.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                data-toc-slug={h.slug}
                class:list={[
                  'toc-link block rounded-md py-1 pr-2 text-muted-foreground transition-colors hover:text-foreground',
                  h.depth === 2 ? 'pl-2' : 'pl-5 text-[13px]',
                ]}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </SidebarCard>
  )
}

<style>
  .toc-link[data-active="true"] {
    color: var(--primary);
    border-left: 2px solid var(--primary);
    padding-left: calc(0.5rem - 2px);
  }
  .toc-link.pl-5[data-active="true"] {
    padding-left: calc(1.25rem - 2px);
  }
</style>

<script>
  // Highlight the TOC entry for the heading currently in view.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));
  if (links.length) {
    const heads = links
      .map((l) => document.getElementById(l.dataset.tocSlug || ''))
      .filter((h): h is HTMLElement => !!h);
    const setActive = (id: string) =>
      links.forEach((l) => l.setAttribute('data-active', String(l.dataset.tocSlug === id)));
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: [0, 1] },
    );
    heads.forEach((h) => io.observe(h));
  }
</script>
