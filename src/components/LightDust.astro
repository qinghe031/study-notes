---
// Rising motes of light — the "光尘" that gives Sky its calm, floating feel.
// Drawn on a canvas that sits behind all content; pointer-events: none.
---

<canvas id="light-dust" aria-hidden="true"></canvas>

<style>
  #light-dust {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Soft fade so motes never compete with text at the edges. */
    mask-image: radial-gradient(ellipse 100% 100% at 50% 40%, #000 55%, transparent 100%);
  }
  @media (prefers-reduced-motion: reduce) {
    #light-dust { display: none; }
  }
</style>

<script>
  const canvas = document.getElementById('light-dust') as HTMLCanvasElement | null;
  if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = canvas.getContext('2d')!;
    let w = 0;
    let h = 0;
    let dpr = 1;

    type Mote = { x: number; y: number; r: number; vy: number; vx: number; a: number; tw: number };
    let motes: Mote[] = [];

    function readPrimary(): string {
      const v = getComputedStyle(document.documentElement).getPropertyValue('--primary').trim();
      return v || '#7fa8c9';
    }
    let color = readPrimary();

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas!.clientWidth;
      h = canvas!.clientHeight;
      canvas!.width = Math.floor(w * dpr);
      canvas!.height = Math.floor(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round((w * h) / 26000);
      motes = Array.from({ length: Math.min(count, 80) }, spawn);
    }

    function spawn(): Mote {
      return {
        x: Math.random() * w,
        y: Math.random() * h,
        r: 0.8 + Math.random() * 2.2,
        vy: -(0.08 + Math.random() * 0.22),
        vx: (Math.random() - 0.5) * 0.15,
        a: 0.12 + Math.random() * 0.35,
        tw: Math.random() * Math.PI * 2,
      };
    }

    let raf = 0;
    function frame() {
      ctx.clearRect(0, 0, w, h);
      for (const m of motes) {
        m.x += m.vx;
        m.y += m.vy;
        m.tw += 0.01 + m.r * 0.004;
        if (m.y < -6) {
          m.y = h + 6;
          m.x = Math.random() * w;
        }
        if (m.x < -6) m.x = w + 6;
        if (m.x > w + 6) m.x = -6;
        const alpha = m.a * (0.6 + 0.4 * Math.sin(m.tw));
        ctx.beginPath();
        ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
        ctx.fillStyle = color;
        ctx.globalAlpha = alpha;
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(frame);
    }

    resize();
    frame();
    window.addEventListener('resize', resize, { passive: true });
    // Recolor motes if the theme hue changes.
    document.querySelectorAll<HTMLButtonElement>('.theme-swatch').forEach((s) =>
      s.addEventListener('click', () => setTimeout(() => (color = readPrimary()), 0)),
    );
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else frame();
    });
  }
</script>
