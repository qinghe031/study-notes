---
import { neteaseEmbedUrl } from '../lib/site';

interface Props {
  id: string;
  kind?: 'song' | 'playlist';
  title?: string;
  /** compact = single row (86px); full = playlist list (430px) */
  size?: 'compact' | 'full';
}
const { id, kind = 'song', title = '网易云音乐播放器', size = 'compact' } = Astro.props;
const height = size === 'full' ? 430 : 86;
---

<div class="netease-embed overflow-hidden rounded-xl" style={`height:${height}px`}>
  <iframe
    title={title}
    src={neteaseEmbedUrl(id, kind, 0)}
    width="100%"
    height={height}
    loading="lazy"
    allow="encrypted-media"
    sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
  ></iframe>
</div>

<style>
  .netease-embed { background: var(--muted); }
  .netease-embed iframe { display: block; border: 0; }
</style>
