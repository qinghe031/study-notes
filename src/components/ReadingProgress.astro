---
// Thin progress bar at the very top of the viewport, tracking article scroll.
---

<div id="reading-progress" class="fixed inset-x-0 top-0 z-[80] h-0.5 bg-transparent" aria-hidden="true">
  <div id="reading-bar" class="h-full w-0 bg-[var(--primary)] transition-[width] duration-75"></div>
</div>

<script>
  const bar = document.getElementById('reading-bar');
  const update = () => {
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    const pct = max > 0 ? (doc.scrollTop / max) * 100 : 0;
    if (bar) bar.style.width = `${pct}%`;
  };
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update, { passive: true });
  update();
</script>
