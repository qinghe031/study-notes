---
import { withBase } from '../lib/url';
import { SITE, SITE_NAV } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';
import WriteNote from './WriteNote.astro';

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header
  class="sticky top-0 z-40 border-b border-border bg-[color-mix(in_srgb,var(--background)_82%,transparent)] backdrop-blur-md"
>
  <div class="shell flex h-14 items-center justify-between gap-4">
    <a href={withBase("/")} class="flex items-center gap-2 font-semibold tracking-tight">
      <span class="inline-block h-6 w-6 rounded-md" style="background: var(--gradient-primary)"></span>
      <span>{SITE.title}</span>
    </a>

    <nav class="hidden items-center gap-0.5 lg:flex">
      {
        SITE_NAV.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={[
              'rounded-md px-3 py-1.5 text-sm transition-colors',
              isActive(item.href)
                ? 'bg-muted text-foreground'
                : 'text-muted-foreground hover:bg-muted hover:text-foreground',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <WriteNote />
      <a
        href={withBase("/search/")}
        aria-label="搜索"
        class="rounded-md p-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </a>
      <ThemeToggle />
      <button
        id="nav-menu-btn"
        aria-label="菜单"
        aria-expanded="false"
        class="rounded-md p-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground lg:hidden"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <nav id="nav-mobile" class="hidden border-t border-border lg:hidden">
    <div class="shell flex flex-col py-2">
      {
        SITE_NAV.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={[
              'rounded-md px-3 py-2 text-sm',
              isActive(item.href) ? 'bg-muted text-foreground' : 'text-muted-foreground',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('nav-menu-btn');
  const menu = document.getElementById('nav-mobile');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
