---
import { withBase } from '../lib/url';
import { SITE, SITE_NAV } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';

const current = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="border-b border-border bg-[color-mix(in_srgb,var(--background)_86%,transparent)] backdrop-blur-md">
  <div class="shell flex min-h-[4rem] flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3">
    <a href={withBase('/')} class="group flex min-w-0 items-baseline gap-3">
      <span class="serif text-xl leading-none tracking-[0.06em] md:text-2xl">{SITE.title}</span>
      <span class="hidden text-xs text-muted-foreground sm:inline-flex sm:items-center sm:gap-2">
        <span class="h-px w-5 bg-border"></span>
        <span class="tracking-wide">{SITE.tagline}</span>
      </span>
    </a>

    <div class="flex items-center gap-4">
      <nav class="hidden items-center gap-5 md:flex">
        {
          SITE_NAV.filter((i) => i.href !== '/').map((item) => (
            <a
              href={withBase(item.href)}
              class:list={[
                'relative text-[0.82rem] tracking-wide transition-colors',
                isActive(item.href) ? 'text-foreground' : 'text-muted-foreground hover:text-foreground',
              ]}
            >
              {item.label}
              {isActive(item.href) && <span class="absolute -bottom-1 left-1/2 h-px w-4 -translate-x-1/2 bg-primary"></span>}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-1">
        <button id="nav-write" type="button" class="chip hidden items-center gap-1.5">✎ 写一页</button>
        <a
          href={withBase('/search/')}
          aria-label="搜索"
          class="rounded-md p-2 text-muted-foreground transition-colors hover:text-foreground"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </a>
        <ThemeToggle />
        <button id="nav-menu-btn" aria-label="菜单" aria-expanded="false" class="rounded-md p-2 text-muted-foreground md:hidden">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
  </div>

  <nav id="nav-mobile" class="hidden border-t border-border md:hidden">
    <div class="shell flex flex-col py-2">
      {
        SITE_NAV.map((item) => (
          <a href={withBase(item.href)} class:list={['rounded-md px-3 py-2 text-sm', isActive(item.href) ? 'text-foreground' : 'text-muted-foreground']}>
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('nav-menu-btn');
  const menu = document.getElementById('nav-mobile');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
