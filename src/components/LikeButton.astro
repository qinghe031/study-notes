---
// Local-first like button. Counts are kept in the browser's localStorage, so it
// works offline and with no backend. Each visitor sees their own tally.
interface Props {
  /** Stable key for this article — the slug. */
  id: string;
  label?: string;
}
const { id, label = '喜欢' } = Astro.props;
---

<button
  type="button"
  class="like-btn group inline-flex items-center gap-2 rounded-full border border-border bg-card px-4 py-2 text-sm transition-all hover:border-primary/50"
  data-like-id={id}
  aria-pressed="false"
  aria-label={label}
>
  <svg class="heart" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
  </svg>
  <span class="like-count tabular-nums">0</span>
  <span class="like-label">{label}</span>
</button>

<style>
  .like-btn[data-liked="true"] {
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, var(--card));
    color: var(--primary);
  }
  .like-btn[data-liked="true"] .heart {
    fill: var(--primary);
  }
  .like-btn.like-pop .heart {
    animation: pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes pop {
    0% { transform: scale(1); }
    45% { transform: scale(1.35); }
    100% { transform: scale(1); }
  }
</style>

<script>
  const KEY = (id: string) => `like:${id}`;
  document.querySelectorAll<HTMLButtonElement>('.like-btn').forEach((btn) => {
    const id = btn.dataset.likeId!;
    const countEl = btn.querySelector('.like-count')!;
    let state = { count: 0, liked: false };
    try {
      const raw = localStorage.getItem(KEY(id));
      if (raw) state = JSON.parse(raw);
    } catch {}
    const render = () => {
      countEl.textContent = String(state.count);
      btn.setAttribute('data-liked', String(state.liked));
      btn.setAttribute('aria-pressed', String(state.liked));
    };
    render();
    btn.addEventListener('click', () => {
      state.liked = !state.liked;
      state.count += state.liked ? 1 : -1;
      if (state.count < 0) state.count = 0;
      try {
        localStorage.setItem(KEY(id), JSON.stringify(state));
      } catch {}
      render();
      btn.classList.remove('like-pop');
      void btn.offsetWidth;
      if (state.liked) btn.classList.add('like-pop');
    });
  });
</script>
