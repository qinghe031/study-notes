---
// 桌宠 — the dog from the model sheet. Three poses that share one head:
//   趴下 lie  (default)   · 蹲下 sit (tap the head)   · 行走 walk (drag it around)
// Black coat, white blaze with freckles, white chest, white socks with black
// spots, pink tongue, rope leash with a carabiner. Pure SVG, no assets.
// Tail click → sync the notebook. Position is remembered.
---

<div id="pet" class="pet-wrap" aria-live="polite" data-pose="lie">
  <div id="pet-bubble" class="card pet-bubble">汪!</div>

  <svg id="pet-svg" viewBox="0 0 240 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="桌宠">
    <defs>
      <linearGradient id="coat" x1="0" y1="0" x2="0.25" y2="1">
        <stop offset="0" stop-color="#3b3e44"/><stop offset="0.5" stop-color="#232629"/><stop offset="1" stop-color="#121416"/>
      </linearGradient>
      <linearGradient id="coat2" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2c2f34"/><stop offset="1" stop-color="#0f1113"/>
      </linearGradient>
      <linearGradient id="white" x1="0" y1="0" x2="0.2" y2="1">
        <stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#dad7d1"/>
      </linearGradient>
      <radialGradient id="eye" cx="40%" cy="38%" r="65%">
        <stop offset="0" stop-color="#8a6a44"/><stop offset="0.65" stop-color="#4a3520"/><stop offset="1" stop-color="#1e150c"/>
      </radialGradient>
      <!-- freckles on the blaze -->
      <pattern id="freckle" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(20)">
        <circle cx="2" cy="2" r="0.9" fill="#2a2d31" opacity="0.55"/><circle cx="5.5" cy="5" r="0.7" fill="#2a2d31" opacity="0.45"/>
      </pattern>
    </defs>

    <ellipse id="pet-ground" cx="120" cy="186" rx="86" ry="6" fill="#1b1f24" opacity="0.10"/>

    <!-- ═══ 趴下 LIE ═══════════════════════════════════════════════════════ -->
    <g id="pose-lie" class="pose">
      <g id="tail-lie" class="pet-tail" data-origin="44 160">
        <path d="M44 160 C26 156 14 142 18 126 C21 114 32 112 36 122 C39 130 30 138 32 146 C34 152 40 156 48 158 Z" fill="url(#coat)"/>
      </g>
      <!-- hind leg tucked under, white foot peeking -->
      <path d="M60 170 C50 156 56 142 74 138 L104 140 L106 172 Z" fill="url(#coat2)"/>
      <path d="M62 172 C58 164 64 158 74 157 C82 156 86 161 84 168 L64 172 Z" fill="url(#white)"/>
      <circle cx="72" cy="166" r="1.3" fill="#2a2d31" opacity="0.5"/>
      <!-- body -->
      <path d="M74 146 C78 130 102 124 130 126 L168 130 C184 132 192 142 192 154 L190 172 L76 172 Z" fill="url(#coat)"/>
      <!-- chest -->
      <path d="M152 148 C158 142 172 142 180 148 C188 154 188 166 184 172 L154 172 C148 164 148 154 152 148 Z" fill="url(#white)"/>
      <!-- front legs: lying flat on the ground, reaching forward, white paws at the front -->
      <path d="M146 174 C150 170 160 170 170 172 L204 180 C210 182 210 190 204 192 L170 192 C160 192 152 189 146 184 Z" fill="url(#coat)"/>
      <path d="M180 182 L204 182 C209 182 210 191 204 192 L180 192 C176 192 174 188 176 185 Z" fill="url(#white)"/>
      <circle cx="190" cy="187" r="1.4" fill="#2a2d31" opacity="0.6"/><circle cx="198" cy="188" r="1.1" fill="#2a2d31" opacity="0.5"/>
      <path d="M126 176 C130 172 140 172 150 174 L184 184 C190 186 190 195 184 197 L150 197 C140 197 132 193 126 187 Z" fill="url(#coat2)"/>
      <path d="M160 186 L184 186 C189 186 190 196 184 197 L160 197 C156 197 154 193 156 189 Z" fill="url(#white)"/>
      <circle cx="170" cy="192" r="1.4" fill="#2a2d31" opacity="0.6"/><circle cx="178" cy="193" r="1.1" fill="#2a2d31" opacity="0.5"/>
      <!-- leash -->
      <path d="M152 170 C132 178 108 182 88 178 C72 175 58 168 50 160" fill="none" stroke="#d2c7b2" stroke-width="3.2" stroke-linecap="round"/>
      <path d="M152 170 C132 178 108 182 88 178 C72 175 58 168 50 160" fill="none" stroke="#a89d88" stroke-width="1" stroke-linecap="round" stroke-dasharray="3 4"/>
      <g class="pet-head-slot" transform="translate(0 10)"><use href="#pet-head-shape"/></g>
    </g>

    <!-- ═══ 蹲下 SIT ═══════════════════════════════════════════════════════ -->
