---
// 桌宠 — the dog from the photo: black coat, white stripe down the long muzzle,
// white chest and front paws, lying with both front legs stretched toward you,
// floppy ears, a rope leash with a clip. Click the head → encouragement.
// Click the tail → sync the notebook.
---

<div id="pet" class="pet-wrap" aria-live="polite">
  <div id="pet-bubble" class="card pet-bubble">汪!</div>

  <svg id="pet-svg" viewBox="0 0 240 170" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="桌宠">
    <defs>
      <linearGradient id="coat" x1="0" y1="0" x2="0.25" y2="1">
        <stop offset="0" stop-color="#3a3d43"/>
        <stop offset="0.55" stop-color="#232629"/>
        <stop offset="1" stop-color="#141618"/>
      </linearGradient>
      <linearGradient id="coat-lo" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2a2d31"/>
        <stop offset="1" stop-color="#101214"/>
      </linearGradient>
      <linearGradient id="white" x1="0" y1="0" x2="0.2" y2="1">
        <stop offset="0" stop-color="#ffffff"/>
        <stop offset="1" stop-color="#dcd9d3"/>
      </linearGradient>
      <radialGradient id="eye" cx="40%" cy="38%" r="65%">
        <stop offset="0" stop-color="#8a6a44"/>
        <stop offset="0.65" stop-color="#4a3520"/>
        <stop offset="1" stop-color="#1e150c"/>
      </radialGradient>
    </defs>

    <!-- ground shadow -->
    <ellipse cx="128" cy="152" rx="96" ry="7" fill="#1b1f24" opacity="0.10"/>

    <!-- ── tail (hit zone; behind body) ── -->
    <g id="pet-tail" class="pet-tail" tabindex="0" role="button" aria-label="点尾巴同步博客">
      <path d="M44 118 C26 114 14 100 18 84 C21 72 32 70 36 80 C39 88 30 96 32 104 C34 110 40 114 48 116 Z" fill="url(#coat)"/>
      <path d="M46 120 C30 118 18 104 22 88" fill="none" stroke="#5a5f66" stroke-width="1.4" stroke-linecap="round" opacity="0.6"/>
    </g>

    <!-- ── haunch + hind foot ── -->
    <path d="M58 124 C50 108 58 96 76 94 L108 96 L110 128 Z" fill="url(#coat-lo)"/>
    <path d="M60 128 C56 118 62 110 74 109 C82 108 86 114 84 122 L62 128 Z" fill="url(#white)"/>

    <!-- ── body (long, low) ── -->
    <path d="M72 100 C76 86 100 80 128 82 L166 86 C182 88 190 98 190 110 L188 128 L74 128 Z" fill="url(#coat)"/>
    <path d="M90 92 C104 88 124 87 140 90" fill="none" stroke="#4a4f56" stroke-width="1.2" stroke-linecap="round" opacity="0.5"/>

    <!-- ── chest ruff (white, under the chin) ── -->
    <path d="M150 104 C156 98 170 98 178 104 C186 110 186 122 182 128 L152 128 C146 120 146 110 150 104 Z" fill="url(#white)"/>

    <!-- ── front legs: two long straight legs reaching toward the viewer ── -->
    <!-- far leg -->
    <path d="M156 118 L170 118 L206 152 C210 156 207 161 201 160 L186 158 L154 126 Z" fill="url(#coat)"/>
    <path d="M184 144 L206 152 C211 154 210 160 203 160 L186 158 Z" fill="url(#white)"/>
    <g stroke="#bdb9b2" stroke-width="1.1" stroke-linecap="round"><line x1="194" y1="153" x2="196" y2="159"/><line x1="200" y1="153" x2="202" y2="159"/></g>
    <!-- near leg -->
    <path d="M140 118 L156 118 L184 156 C188 161 184 166 178 164 L164 160 L138 128 Z" fill="url(#coat)"/>
    <path d="M160 146 L184 156 C189 158 187 165 180 164 L164 160 Z" fill="url(#white)"/>
    <g stroke="#bdb9b2" stroke-width="1.1" stroke-linecap="round"><line x1="170" y1="157" x2="172" y2="163"/><line x1="177" y1="157" x2="179" y2="163"/></g>

    <!-- ── rope leash with clip, trailing off to the left ── -->
    <path d="M150 128 C130 136 106 140 86 136 C70 133 56 126 48 118" fill="none" stroke="#d2c7b2" stroke-width="3.2" stroke-linecap="round"/>
    <path d="M150 128 C130 136 106 140 86 136 C70 133 56 126 48 118" fill="none" stroke="#a89d88" stroke-width="1" stroke-linecap="round" stroke-dasharray="3 4"/>
    <path d="M150 122 l6 10" stroke="#8d939a" stroke-width="3.2" stroke-linecap="round"/>
    <circle cx="149" cy="121" r="3.2" fill="none" stroke="#8d939a" stroke-width="2"/>

    <!-- ── head (hit zone) ── -->
    <g id="pet-head" class="pet-head" tabindex="0" role="button" aria-label="点我的头">
      <!-- floppy ears, hanging -->
      <path d="M134 64 C124 56 120 70 124 84 C126 92 134 96 140 92 C142 84 140 72 134 64 Z" fill="url(#coat-lo)"/>
      <path d="M196 60 C206 54 212 66 208 80 C206 88 198 92 192 88 C190 80 192 68 196 60 Z" fill="url(#coat-lo)"/>
      <!-- skull: wide at the back, tapering into a long muzzle (down-right) -->
      <path d="M136 70 C136 52 152 42 168 42 C184 42 198 52 198 68 C198 78 194 86 188 92 L204 112 C208 118 204 126 196 126 L176 126 C166 126 158 120 154 112 L146 96 C140 90 136 80 136 70 Z" fill="url(#coat)"/>
      <!-- white blaze: from forehead down the muzzle -->
      <path d="M166 52 C172 50 178 54 178 62 L182 90 L200 112 C204 118 200 125 194 125 L178 125 C170 125 165 119 163 112 L158 90 C156 78 160 60 166 52 Z" fill="url(#white)"/>
      <!-- muzzle shading -->
      <path d="M170 92 L188 112 C192 117 190 122 185 122 L176 122 C170 121 167 116 166 110 Z" fill="#ecebe6"/>
      <!-- nose -->
      <path d="M194 110 C200 110 205 114 204 119 C203 124 197 125 193 122 C190 119 190 112 194 110 Z" fill="#1d2025"/>
      <ellipse cx="196" cy="113.5" rx="1.8" ry="1" fill="#4e545b" opacity="0.8"/>
      <!-- mouth, slightly open -->
      <path d="M192 122 C190 126 184 127 180 125" fill="none" stroke="#2a2d33" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M184 125 C185 128 188 129 190 127" fill="#c96f7a" stroke="#8e4a55" stroke-width="0.6"/>
      <!-- eyes -->
      <ellipse cx="156" cy="72" rx="4.4" ry="4" fill="url(#eye)" class="pet-eye"/>
      <ellipse cx="176" cy="70" rx="4.4" ry="4" fill="url(#eye)" class="pet-eye"/>
      <circle cx="157.5" cy="70.4" r="1.3" fill="#fff" opacity="0.9"/>
      <circle cx="177.5" cy="68.4" r="1.3" fill="#fff" opacity="0.9"/>
      <!-- tan brow dots -->
      <circle cx="152" cy="63" r="1.6" fill="#8a6a44" opacity="0.6"/>
      <circle cx="180" cy="61" r="1.6" fill="#8a6a44" opacity="0.6"/>
      <!-- whiskers -->
      <g stroke="#e9e6df" stroke-width="0.7" stroke-linecap="round" opacity="0.7">
        <line x1="204" y1="116" x2="216" y2="112"/><line x1="204" y1="120" x2="217" y2="121"/>
        <line x1="172" y1="120" x2="166" y2="128"/>
      </g>
    </g>
  </svg>
</div>

<style>
  .pet-wrap { position: fixed; bottom: 0.5rem; left: 0.75rem; z-index: 30; width: 9rem; user-select: none; }
  .pet-bubble {
    position: absolute; bottom: 100%; left: 0.5rem; margin-bottom: 0.2rem;
    padding: 0.3rem 0.65rem; border-radius: 0.6rem; font-size: 0.78rem; width: max-content; max-width: 12rem;
    opacity: 0; transform: translateY(4px); transition: opacity 0.25s, transform 0.25s;
    pointer-events: none;
  }
  .pet-bubble.show { opacity: 1; transform: translateY(0); }
  .pet-wrap svg { width: 100%; height: auto; overflow: visible; }

  .pet-head, .pet-tail { cursor: pointer; }
  .pet-head { transform-box: view-box; transform-origin: 160px 80px; transition: transform 0.25s ease; }
  .pet-tail { transform-box: view-box; transform-origin: 46px 118px; transition: transform 0.25s ease; }
  .pet-head:hover { transform: rotate(-3deg) translateY(-1.5px); }
  .pet-tail:hover { transform: rotate(-10deg); }

  .pet-head.pat { animation: pet-pat 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes pet-pat { 0%, 100% { transform: translateY(0) rotate(0); } 35% { transform: translateY(3px) rotate(2deg); } 65% { transform: translateY(-2px) rotate(-2deg); } }
  .pet-tail.wag { animation: pet-wag 0.45s ease-in-out 4; }
  @keyframes pet-wag { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(-22deg); } }

  .pet-eye { animation: pet-blink 5s infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes pet-blink { 0%, 94%, 100% { transform: scaleY(1); } 97% { transform: scaleY(0.12); } }

  @media (prefers-reduced-motion: reduce) { .pet-head, .pet-tail, .pet-eye { animation: none !important; transition: none; } }
</style>

<script>
  import { pending } from '../lib/notebook';

  const bubble = document.getElementById('pet-bubble')!;
  const head = document.getElementById('pet-head')!;
  const tail = document.getElementById('pet-tail')!;

  const LINES = ['汪!休息一下也没关系。', '今天也写一点吧。', '你已经比昨天多懂一点了。', '慢慢来,不着急。', '写下来,就记住了。', '我在这儿陪着你。', '摸摸头,继续加油。'];
  let last = -1, timer = 0;
  function say(text: string, ms = 2600) {
    bubble.textContent = text; bubble.classList.add('show');
    clearTimeout(timer); timer = window.setTimeout(() => bubble.classList.remove('show'), ms);
  }
  const replay = (el: HTMLElement, cls: string) => { el.classList.remove(cls); void el.getBoundingClientRect(); el.classList.add(cls); };

  head.addEventListener('click', () => {
    let i; do { i = Math.floor(Math.random() * LINES.length); } while (i === last && LINES.length > 1);
    last = i; replay(head, 'pat'); say(LINES[i]);
  });

  tail.addEventListener('click', async () => {
    replay(tail, 'wag');
    const n = pending().count;
    if (n === 0) { say('都同步过啦,没有要发的。', 2400); return; }
    say(`正在同步 ${n} 项…`, 60000);
    const r = await (window as any).__notebook?.syncAll?.();
    if (!r) { say('同步取消了。'); return; }
    say(r.ok ? '同步好了 ✓ 约 1~2 分钟后网站更新' : '没同步成功:' + (r.errors[0] || '未知错误'), 3800);
  });

  for (const el of [head, tail]) el.addEventListener('keydown', (e: any) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); el.dispatchEvent(new MouseEvent('click')); } });

  setTimeout(() => { const n = pending().count; say(n ? `有 ${n} 项还没发到网站上,点我尾巴可以同步。` : LINES[0], n ? 4200 : 2600); }, 1200);
</script>