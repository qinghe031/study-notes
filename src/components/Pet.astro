      <path d="M126 178 C126 173 130 170 139 170 C148 170 152 173 152 178 L152 184 C152 189 148 191 139 191 C130 191 126 189 126 184 Z" fill="url(#white)"/>
      <circle cx="134" cy="183" r="1.3" fill="#2a2d31" opacity="0.6"/><circle cx="142" cy="186" r="1.1" fill="#2a2d31" opacity="0.5"/>
      <path d="M156 152 C156 150 158 148 162 148 L172 148 C176 148 178 150 178 152 L178 180 L156 180 Z" fill="url(#coat)"/>
      <path d="M154 178 C154 173 158 170 167 170 C176 170 180 173 180 178 L180 184 C180 189 176 191 167 191 C158 191 154 189 154 184 Z" fill="url(#white)"/>
      <circle cx="162" cy="183" r="1.3" fill="#2a2d31" opacity="0.6"/><circle cx="170" cy="186" r="1.1" fill="#2a2d31" opacity="0.5"/>
      <!-- leash hanging -->
      <path d="M152 152 C144 162 132 168 120 170" fill="none" stroke="#d2c7b2" stroke-width="3" stroke-linecap="round"/>
      <path d="M152 152 C144 162 132 168 120 170" fill="none" stroke="#a89d88" stroke-width="1" stroke-linecap="round" stroke-dasharray="3 4"/>
      <g class="pet-head-slot" transform="translate(-4 -22)"><use href="#pet-head-shape"/></g>
