    <!-- ═══ 行走 WALK ══════════════════════════════════════════════════════ -->
    <g id="pose-walk" class="pose">
      <g id="tail-walk" class="pet-tail pet-tail--up" data-origin="54 124">
        <path d="M54 124 C42 114 36 100 44 88 C50 80 60 84 58 94 C57 102 50 108 52 116 C53 120 56 122 60 124 Z" fill="url(#coat)"/>
      </g>
      <!-- body -->
      <path d="M60 128 C64 110 90 102 120 104 L162 108 C180 110 190 120 190 134 L188 152 L64 152 Z" fill="url(#coat)"/>
      <path d="M150 128 C156 122 170 122 178 128 C186 134 186 148 182 152 L152 152 C146 144 146 136 150 128 Z" fill="url(#white)"/>
      <!-- legs: back pair, front pair -->
      <g class="leg leg-a" data-origin="78 148"><path d="M70 148 L86 148 L85 178 C85 181 83 182 80 182 L76 182 C73 182 71 181 71 178 Z" fill="url(#coat2)"/><path d="M69 178 C69 174 72 172 78 172 C84 172 87 174 87 178 L87 185 C87 189 84 191 78 191 C72 191 69 189 69 185 Z" fill="url(#white)"/><circle cx="75" cy="183" r="1.3" fill="#2a2d31" opacity="0.6"/><circle cx="81" cy="186" r="1.1" fill="#2a2d31" opacity="0.5"/></g>
      <g class="leg leg-b" data-origin="100 148"><path d="M92 148 L108 148 L107 178 C107 181 105 182 102 182 L98 182 C95 182 93 181 93 178 Z" fill="url(#coat)"/><path d="M91 178 C91 174 94 172 100 172 C106 172 109 174 109 178 L109 185 C109 189 106 191 100 191 C94 191 91 189 91 185 Z" fill="url(#white)"/><circle cx="97" cy="183" r="1.3" fill="#2a2d31" opacity="0.6"/><circle cx="103" cy="186" r="1.1" fill="#2a2d31" opacity="0.5"/></g>
      <g class="leg leg-c" data-origin="148 148"><path d="M140 148 L156 148 L155 178 C155 181 153 182 150 182 L146 182 C143 182 141 181 141 178 Z" fill="url(#coat2)"/><path d="M139 178 C139 174 142 172 148 172 C154 172 157 174 157 178 L157 185 C157 189 154 191 148 191 C142 191 139 189 139 185 Z" fill="url(#white)"/><circle cx="145" cy="183" r="1.3" fill="#2a2d31" opacity="0.6"/><circle cx="151" cy="186" r="1.1" fill="#2a2d31" opacity="0.5"/></g>
      <g class="leg leg-d" data-origin="170 148"><path d="M162 148 L178 148 L177 178 C177 181 175 182 172 182 L168 182 C165 182 163 181 163 178 Z" fill="url(#coat)"/><path d="M161 178 C161 174 164 172 170 172 C176 172 179 174 179 178 L179 185 C179 189 176 191 170 191 C164 191 161 189 161 185 Z" fill="url(#white)"/><circle cx="167" cy="183" r="1.3" fill="#2a2d31" opacity="0.6"/><circle cx="173" cy="186" r="1.1" fill="#2a2d31" opacity="0.5"/></g>
      <!-- leash trailing -->
      <path d="M158 140 C142 150 122 154 106 150 C92 147 80 140 72 132" fill="none" stroke="#d2c7b2" stroke-width="3" stroke-linecap="round"/>
      <path d="M158 140 C142 150 122 154 106 150 C92 147 80 140 72 132" fill="none" stroke="#a89d88" stroke-width="1" stroke-linecap="round" stroke-dasharray="3 4"/>
      <g class="pet-head-slot" transform="translate(6 -10)"><use href="#pet-head-shape"/></g>
    </g>

    <!-- ═══ shared head (defined once, placed per pose) ═══════════════════ -->
    <defs>
      <g id="pet-head-shape">
        <!-- floppy ears -->
        <path d="M134 92 C124 84 120 98 124 112 C126 120 134 124 140 120 C142 112 140 100 134 92 Z" fill="url(#coat2)"/>
        <path d="M198 88 C208 82 214 94 210 108 C208 116 200 120 194 116 C192 108 194 96 198 88 Z" fill="url(#coat2)"/>
        <!-- skull + long muzzle -->
        <path d="M136 98 C136 80 152 70 168 70 C184 70 198 80 198 96 C198 106 194 114 188 120 L204 140 C208 146 204 154 196 154 L176 154 C166 154 158 148 154 140 L146 124 C140 118 136 108 136 98 Z" fill="url(#coat)"/>
        <!-- white blaze w/ freckles -->
        <path d="M166 80 C172 78 178 82 178 90 L182 118 L200 140 C204 146 200 153 194 153 L178 153 C170 153 165 147 163 140 L158 118 C156 106 160 88 166 80 Z" fill="url(#white)"/>
        <path d="M166 80 C172 78 178 82 178 90 L182 118 L200 140 C204 146 200 153 194 153 L178 153 C170 153 165 147 163 140 L158 118 C156 106 160 88 166 80 Z" fill="url(#freckle)"/>
        <!-- carabiner + rope knot at the collar -->
        <path d="M150 150 l5 9" stroke="#8d939a" stroke-width="3" stroke-linecap="round"/>
        <circle cx="149" cy="149" r="3.2" fill="none" stroke="#8d939a" stroke-width="2"/>
        <circle cx="156" cy="160" r="3.5" fill="#d2c7b2" stroke="#a89d88" stroke-width="1"/>
        <!-- nose -->
        <path d="M194 138 C200 138 205 142 204 147 C203 152 197 153 193 150 C190 147 190 140 194 138 Z" fill="#1d2025"/>
        <ellipse cx="196" cy="141.5" rx="1.8" ry="1" fill="#4e545b" opacity="0.8"/>
        <!-- open mouth + tongue -->
        <path d="M192 150 C190 156 184 158 178 156" fill="none" stroke="#2a2d33" stroke-width="1.2" stroke-linecap="round"/>
        <path d="M181 155 C182 160 186 162 189 159 C190 157 188 154 186 154 Z" fill="#d97a86" stroke="#9c4f5b" stroke-width="0.6"/>
        <!-- eyes -->
        <ellipse cx="156" cy="100" rx="4.4" ry="4" fill="url(#eye)" class="pet-eye"/>
        <ellipse cx="176" cy="98" rx="4.4" ry="4" fill="url(#eye)" class="pet-eye"/>
        <circle cx="157.5" cy="98.4" r="1.3" fill="#fff" opacity="0.9"/>
        <circle cx="177.5" cy="96.4" r="1.3" fill="#fff" opacity="0.9"/>
        <!-- whiskers -->
        <g stroke="#e9e6df" stroke-width="0.7" stroke-linecap="round" opacity="0.7">
          <line x1="204" y1="144" x2="216" y2="140"/><line x1="204" y1="148" x2="217" y2="149"/>
        </g>
        <!-- hit zone on top -->
        <path id="pet-head-hit" d="M130 70 L210 70 L212 156 L150 160 L130 120 Z" fill="transparent" />
      </g>
    </defs>
  </svg>
</div>

<style>
  .pet-wrap { position: fixed; bottom: 0.25rem; left: 0.75rem; z-index: 30; width: 9.5rem; user-select: none; touch-action: none; }
  .pet-wrap.dragging { cursor: grabbing; }
  .pet-wrap svg { width: 100%; height: auto; overflow: visible; display: block; }
  .pet-wrap.flip svg { transform: scaleX(-1); }
  .pet-bubble {
    position: absolute; bottom: 100%; left: 0.5rem; margin-bottom: 0.1rem;
    padding: 0.3rem 0.65rem; border-radius: 0.6rem; font-size: 0.78rem; width: max-content; max-width: 12rem;
    opacity: 0; transform: translateY(4px); transition: opacity 0.25s, transform 0.25s; pointer-events: none;
  }
  .pet-bubble.show { opacity: 1; transform: translateY(0); }

  /* one pose visible at a time */
  .pose { display: none; }
  .pet-wrap[data-pose="lie"]  #pose-lie,
  .pet-wrap[data-pose="sit"]  #pose-sit,
  .pet-wrap[data-pose="walk"] #pose-walk { display: inline; }

  :global(#pet-head-hit) { cursor: pointer; }
  .pet-tail { cursor: pointer; transform-box: view-box; transition: transform 0.25s ease; }
  .pet-tail:hover { transform: rotate(-10deg); }
  .pet-tail.wag { animation: pet-wag 0.45s ease-in-out 4; }
  @keyframes pet-wag { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(-22deg); } }
  .pet-tail--up.wag { animation-name: pet-wag-up; }
  @keyframes pet-wag-up { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(16deg); } }

  /* sit: a little bob on arrival */
  .pet-wrap[data-pose="sit"] #pose-sit { animation: pet-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1); transform-box: view-box; transform-origin: 140px 190px; }
  @keyframes pet-pop { 0% { transform: translateY(6px) scaleY(0.96); } 100% { transform: none; } }

  /* walk: legs swing while dragging, whole body bobs */
  .leg { transform-box: view-box; }
  .pet-wrap.dragging .leg-a, .pet-wrap.dragging .leg-c { animation: pet-step 0.42s ease-in-out infinite; }
  .pet-wrap.dragging .leg-b, .pet-wrap.dragging .leg-d { animation: pet-step 0.42s ease-in-out infinite reverse; }
  @keyframes pet-step { 0%, 100% { transform: rotate(-12deg); } 50% { transform: rotate(12deg); } }
  .pet-wrap.dragging #pose-walk { animation: pet-bob 0.42s ease-in-out infinite; transform-box: view-box; transform-origin: 120px 190px; }
  @keyframes pet-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-2px); } }

  :global(.pet-eye) { animation: pet-blink 5s infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes pet-blink { 0%, 94%, 100% { transform: scaleY(1); } 97% { transform: scaleY(0.12); } }

  @media (prefers-reduced-motion: reduce) { .pet-tail, .leg, #pose-walk, #pose-sit, :global(.pet-eye) { animation: none !important; transition: none; } }
</style>

<script>
  import { pending } from '../lib/notebook';

  const wrap = document.getElementById('pet')!;
  const svg = document.getElementById('pet-svg') as unknown as SVGSVGElement;
  const bubble = document.getElementById('pet-bubble')!;
  const POS_KEY = 'pet:pos';

  // Leg/tail pivots: set transform-origin from data-origin (view-box coords).
  svg.querySelectorAll<SVGElement>('[data-origin]').forEach((el) => {
    const [x, y] = (el.dataset.origin || '0 0').split(' ');
    el.style.transformOrigin = `${x}px ${y}px`;
  });

  const LINES = ['汪!休息一下也没关系。', '今天也写一点吧。', '你已经比昨天多懂一点了。', '慢慢来,不着急。', '写下来,就记住了。', '我在这儿陪着你。', '摸摸头,继续加油。'];
  let last = -1, bubbleTimer = 0;
  function say(text: string, ms = 2600) {
    bubble.textContent = text; bubble.classList.add('show');
    clearTimeout(bubbleTimer); bubbleTimer = window.setTimeout(() => bubble.classList.remove('show'), ms);
  }
  const replay = (el: Element, cls: string) => { el.classList.remove(cls); void (el as HTMLElement).getBoundingClientRect(); el.classList.add(cls); };

  /* ── pose state machine ─────────────────────────────────────────────── */
  let sitTimer = 0;
  function setPose(p: 'lie' | 'sit' | 'walk') { wrap.dataset.pose = p; }
  function sitFor(ms: number) {
    setPose('sit');
    clearTimeout(sitTimer);
    sitTimer = window.setTimeout(() => { if (!dragging) setPose('lie'); }, ms);
  }

  /* ── head: encouragement + sit ──────────────────────────────────────── */
  svg.addEventListener('click', (e) => {
    if (dragMoved) return; // a drag, not a tap
    const t = e.target as Element;
    if (t.closest('.pet-tail')) return;
    // head hit zone lives inside <use>; test by y position within the head area instead
    const pt = svgPoint(e);
    if (pt && pt.y < 160 && pt.x > 125) {
      let i; do { i = Math.floor(Math.random() * LINES.length); } while (i === last && LINES.length > 1);
      last = i; say(LINES[i]); sitFor(3200);
    }
  });
  function svgPoint(e: MouseEvent | PointerEvent) {
    const r = svg.getBoundingClientRect();
    const vb = svg.viewBox.baseVal;
    let x = ((e.clientX - r.left) / r.width) * vb.width;
    if (wrap.classList.contains('flip')) x = vb.width - x;
    const y = ((e.clientY - r.top) / r.height) * vb.height;
    return { x, y };
  }

  /* ── tail: sync ─────────────────────────────────────────────────────── */
  svg.querySelectorAll('.pet-tail').forEach((tail) => tail.addEventListener('click', async (e) => {
    e.stopPropagation();
    if (dragMoved) return;
    replay(tail, 'wag');
    const n = pending().count;
    if (n === 0) { say('都同步过啦,没有要发的。', 2400); return; }
    say(`正在同步 ${n} 项…`, 60000);
    const r = await (window as any).__notebook?.syncAll?.();
    if (!r) { say('同步取消了。'); return; }
    say(r.ok ? '同步好了 ✓ 约 1~2 分钟后网站更新' : '没同步成功:' + (r.errors[0] || '未知错误'), 3800);
  }));

  /* ── drag: walk ─────────────────────────────────────────────────────── */
  let dragging = false, dragMoved = false;
  let startX = 0, startY = 0, originLeft = 0, originBottom = 0, lastX = 0;
  function applyPos(left: number, bottom: number) {
    const maxL = window.innerWidth - wrap.offsetWidth - 4;
    const maxB = window.innerHeight - wrap.offsetHeight - 4;
    left = Math.max(4, Math.min(left, maxL)); bottom = Math.max(0, Math.min(bottom, maxB));
    wrap.style.left = left + 'px'; wrap.style.bottom = bottom + 'px';
    return { left, bottom };
  }
  svg.addEventListener('pointerdown', (e) => {
    if ((e.target as Element).closest('.pet-tail')) return;
    dragging = true; dragMoved = false;
    startX = e.clientX; startY = e.clientY; lastX = e.clientX;
    const r = wrap.getBoundingClientRect();
    originLeft = r.left; originBottom = window.innerHeight - r.bottom;
    svg.setPointerCapture(e.pointerId);
  });
  svg.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    const dx = e.clientX - startX, dy = e.clientY - startY;
    if (!dragMoved && Math.hypot(dx, dy) > 6) { dragMoved = true; clearTimeout(sitTimer); setPose('walk'); wrap.classList.add('dragging'); }
    if (!dragMoved) return;
    // face the direction of travel
    if (Math.abs(e.clientX - lastX) > 2) wrap.classList.toggle('flip', e.clientX < lastX);
    lastX = e.clientX;
    applyPos(originLeft + dx, originBottom - dy);
  });
  const endDrag = (e: PointerEvent) => {
    if (!dragging) return;
    dragging = false;
    try { svg.releasePointerCapture(e.pointerId); } catch {}
    if (dragMoved) {
      wrap.classList.remove('dragging');
      const r = wrap.getBoundingClientRect();
      try { localStorage.setItem(POS_KEY, JSON.stringify({ left: r.left, bottom: window.innerHeight - r.bottom })); } catch {}
      setTimeout(() => setPose('lie'), 220);
      setTimeout(() => (dragMoved = false), 50);
    }
  };
  svg.addEventListener('pointerup', endDrag);
  svg.addEventListener('pointercancel', endDrag);

  // restore position
  try {
    const p = JSON.parse(localStorage.getItem(POS_KEY) || 'null');
    if (p) applyPos(p.left, p.bottom);
  } catch {}
  window.addEventListener('resize', () => { const r = wrap.getBoundingClientRect(); applyPos(r.left, window.innerHeight - r.bottom); });

  setTimeout(() => { const n = pending().count; say(n ? `有 ${n} 项还没发到网站上,点我尾巴可以同步。` : LINES[0], n ? 4200 : 2600); }, 1200);
</script>