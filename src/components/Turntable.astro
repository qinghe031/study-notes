---
import { withBase } from '../lib/url';
// Turntable for the homepage. Click the record: the tonearm swings onto the
// vinyl, the platter starts spinning, and the NetEase player fades in and
// starts playing. Click again to lift the arm and pause.
import { NOW_PLAYING, neteaseEmbedUrl } from '../lib/site';

const { nowPlaying } = NOW_PLAYING;
const id = nowPlaying?.neteaseId || '';
const has = Boolean(id);
const src = has ? neteaseEmbedUrl(id, 'song', 1) : '';
const lyrics = (nowPlaying?.lyrics || '').trim();
// LRC if the first non-empty line starts with a [mm:ss] tag.
const isLrc = /^\s*\[\d{1,2}:\d{2}(?:[.:]\d{1,3})?\]/.test(lyrics);
// Parse into { t, text } once here so the template stays simple.
const LRC_RE = /^\s*\[(\d{1,2}):(\d{2})(?:[.:](\d{1,3}))?\](.*)$/;
const lyricLines = lyrics
  .split('\n')
  .map((raw) => {
    const m = raw.match(LRC_RE);
    const text = (m ? m[4] : raw).trim();
    const t = m ? Number(m[1]) * 60 + Number(m[2]) + (m[3] ? Number('0.' + m[3]) : 0) : -1;
    return { t, text };
  })
  .filter((l) => l.text.length > 0);
---

<section class="turntable-wrap reveal card relative overflow-hidden p-5 md:p-6">
  <div class="grid items-center gap-5 md:grid-cols-[auto_minmax(0,1fr)] lg:grid-cols-[auto_minmax(0,1fr)_minmax(0,1.1fr)] md:gap-8">
    <!-- ── the deck ── -->
    <button
      id="tt-btn"
      type="button"
      class="turntable relative shrink-0 self-center"
      aria-label={has ? '播放 / 暂停' : '还没有填歌'}
      aria-pressed="false"
      disabled={!has}
    >
      <svg viewBox="0 0 240 200" class="h-48 w-60 md:h-52 md:w-64" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="tt-plinth" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#e9e2d6"/>
            <stop offset="1" stop-color="#cfc4b3"/>
          </linearGradient>
          <linearGradient id="tt-plinth-d" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#3a3f48"/>
            <stop offset="1" stop-color="#262a31"/>
          </linearGradient>
          <radialGradient id="tt-vinyl" cx="50%" cy="50%" r="50%">
            <stop offset="0" stop-color="#2c2c30"/>
            <stop offset="0.55" stop-color="#1b1b1e"/>
            <stop offset="0.56" stop-color="#2a2a2e"/>
            <stop offset="0.7" stop-color="#1b1b1e"/>
            <stop offset="0.71" stop-color="#2a2a2e"/>
            <stop offset="0.85" stop-color="#1b1b1e"/>
            <stop offset="1" stop-color="#141416"/>
          </radialGradient>
          <linearGradient id="tt-shine" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#fff" stop-opacity="0.18"/>
            <stop offset="0.5" stop-color="#fff" stop-opacity="0"/>
          </linearGradient>
          <radialGradient id="tt-label" cx="50%" cy="50%" r="50%">
            <stop offset="0" stop-color="color-mix(in srgb, var(--primary) 70%, white)"/>
            <stop offset="1" stop-color="var(--primary)"/>
          </radialGradient>
          <linearGradient id="tt-metal" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#f4f4f5"/>
            <stop offset="0.5" stop-color="#b8bcc4"/>
            <stop offset="1" stop-color="#e5e7eb"/>
          </linearGradient>
          <filter id="tt-shadow" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#000" flood-opacity="0.25"/>
          </filter>
        </defs>

        <!-- plinth -->
        <rect class="plinth" x="8" y="20" width="224" height="164" rx="14" fill="url(#tt-plinth)" filter="url(#tt-shadow)"/>
        <rect x="8" y="20" width="224" height="164" rx="14" fill="url(#tt-shine)"/>
        <!-- feet -->
        <rect x="24" y="182" width="24" height="8" rx="3" fill="#8a8178"/>
        <rect x="192" y="182" width="24" height="8" rx="3" fill="#8a8178"/>

        <!-- platter mat -->
        <circle cx="96" cy="102" r="76" fill="#1e1f23"/>
        <circle cx="96" cy="102" r="74" fill="#2a2b30"/>

        <!-- vinyl record (spins) -->
        <g class="record">
          <circle cx="96" cy="102" r="70" fill="url(#tt-vinyl)"/>
          <!-- groove rings -->
          <g fill="none" stroke="#3a3a3f" stroke-width="0.6" opacity="0.8">
            <circle cx="96" cy="102" r="64"/><circle cx="96" cy="102" r="58"/><circle cx="96" cy="102" r="52"/>
            <circle cx="96" cy="102" r="46"/><circle cx="96" cy="102" r="40"/><circle cx="96" cy="102" r="34"/>
          </g>
          <!-- light sheen across the vinyl -->
          <path d="M40 70 A70 70 0 0 1 96 32 L96 102 Z" fill="#fff" opacity="0.06"/>
          <!-- label -->
          <circle cx="96" cy="102" r="24" fill="url(#tt-label)"/>
          <circle cx="96" cy="102" r="24" fill="none" stroke="#fff" stroke-opacity="0.25"/>
          <text x="96" y="99" text-anchor="middle" font-size="7" font-family="ui-sans-serif, system-ui" fill="#fff" fill-opacity="0.9" letter-spacing="1">NOW</text>
          <text x="96" y="110" text-anchor="middle" font-size="7" font-family="ui-sans-serif, system-ui" fill="#fff" fill-opacity="0.9" letter-spacing="1">PLAYING</text>
          <circle cx="96" cy="102" r="3" fill="#111"/>
        </g>

        <!-- spindle -->
        <circle cx="96" cy="102" r="2" fill="url(#tt-metal)"/>

        <!-- tonearm base -->
        <circle cx="196" cy="56" r="16" fill="url(#tt-metal)" stroke="#9ca3af" stroke-width="1"/>
        <circle cx="196" cy="56" r="9" fill="#d1d5db"/>
        <circle cx="196" cy="56" r="4" fill="#6b7280"/>

        <!-- tonearm (pivots at base) -->
        <g class="tonearm">
          <!-- counterweight -->
          <rect x="202" y="50" width="18" height="12" rx="3" fill="#4b5563"/>
          <!-- arm tube -->
          <line x1="196" y1="56" x2="118" y2="124" stroke="url(#tt-metal)" stroke-width="5" stroke-linecap="round"/>
          <line x1="196" y1="56" x2="118" y2="124" stroke="#6b7280" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
          <!-- headshell -->
          <g transform="translate(118 124) rotate(-41)">
            <rect x="-8" y="-5" width="22" height="10" rx="2" fill="#374151"/>
            <rect x="2" y="3" width="6" height="7" rx="1" fill="#9ca3af"/>
          </g>
        </g>

        <!-- play indicator -->
        <circle class="led" cx="34" cy="44" r="4" fill="#9ca3af"/>
        <!-- speed toggle -->
        <rect x="26" y="150" width="28" height="10" rx="5" fill="#8a8178"/>
        <circle class="knob" cx="34" cy="155" r="4" fill="#f4f4f5"/>
      </svg>

      <span class="tt-hint pointer-events-none absolute inset-x-0 -bottom-1 text-center text-[11px] text-muted-foreground">
        {has ? '点一下唱片' : '还没有填歌'}
      </span>
    </button>

    <!-- ── track info + player ── -->
    <div class="min-w-0 self-center">
      <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground">Now playing</p>
      {
        has ? (
          <>
            <h2 class="mt-1 truncate text-xl font-semibold tracking-tight md:text-2xl">{nowPlaying.title || '未命名'}</h2>
            {nowPlaying.artist && <p class="mt-0.5 truncate text-sm text-muted-foreground">{nowPlaying.artist}</p>}
            <p id="tt-status" class="mt-3 text-xs text-muted-foreground">待机中</p>
            <div id="tt-player" class="tt-player mt-3 overflow-hidden rounded-xl" data-src={src} aria-hidden="true">
              <!-- iframe is inserted on first play so the browser treats it as a user-initiated autoplay -->
            </div>
            <a href={withBase("/now-playing/")} class="mt-3 inline-block text-xs text-muted-foreground hover:text-primary">查看全部歌单 →</a>
          </>
        ) : (
          <>
            <h2 class="mt-1 text-xl font-semibold tracking-tight md:text-2xl text-muted-foreground">还没放唱片</h2>
            <p class="mt-2 text-sm text-muted-foreground">
              打开 <code class="rounded bg-muted px-1.5 py-0.5">src/data/now-playing.json</code>,把网易云歌曲 ID 填进
              <code class="rounded bg-muted px-1.5 py-0.5">nowPlaying.neteaseId</code>,或者去
              <a href={withBase("/admin/#music")} class="text-primary">后台</a> 粘贴链接。
            </p>
          </>
        )
      }
    </div>

    <!-- ── lyrics ── -->
    {
      has && (
        <div class="tt-lyrics-wrap relative min-w-0 self-center md:col-span-2 lg:col-span-1">
          <p class="mb-2 text-xs uppercase tracking-[0.2em] text-muted-foreground">Lyrics</p>
          {lyrics ? (
            <div id="tt-lyrics" class="tt-lyrics relative h-44 overflow-hidden rounded-xl bg-muted/50 px-4" data-lrc={String(isLrc)}>
              <div id="tt-lyrics-inner" class="tt-lyrics-inner py-[4.5rem] text-sm leading-7 text-muted-foreground">
                {lyricLines.map((l) => (
                  <p class="tt-line" data-t={l.t >= 0 ? l.t.toFixed(2) : undefined}>{l.text}</p>
                ))}
              </div>
            </div>
          ) : (
            <div class="flex h-44 items-center justify-center rounded-xl bg-muted/50 px-4 text-center text-xs text-muted-foreground">
              在 <code class="mx-1 rounded bg-muted px-1 py-0.5">now-playing.json</code> 的 <code class="mx-1 rounded bg-muted px-1 py-0.5">lyrics</code> 里贴上歌词
              <br />(带时间戳的 LRC 会跟着滚动)
            </div>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  :global(html.dark) .plinth { fill: url(#tt-plinth-d); }

  .turntable:disabled { cursor: default; opacity: 0.75; }

  .record {
    transform-box: fill-box;
    transform-origin: center;
  }
  .tonearm {
    transform-box: view-box;
    transform-origin: 196px 56px;
    transform: rotate(-22deg);
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .led { transition: fill 0.3s ease; }
  .knob { transition: cx 0.3s ease; }

  /* ── playing state ── */
  .turntable[aria-pressed="true"] .record {
    animation: tt-spin 1.8s linear infinite;
  }
  .turntable[aria-pressed="true"] .tonearm {
    transform: rotate(0deg);
  }
  .turntable[aria-pressed="true"] .led {
    fill: var(--primary);
    filter: drop-shadow(0 0 4px var(--primary));
  }
  .turntable[aria-pressed="true"] .knob { cx: 46; }
  .turntable[aria-pressed="true"] .tt-hint { opacity: 0; }

  /* spin-down when pausing: keep last rotation, decelerate */
  .turntable[data-stopping="true"] .record {
    animation: tt-spin 1.8s linear infinite;
    animation-play-state: paused;
  }

  @keyframes tt-spin {
    to { transform: rotate(360deg); }
  }

  /* hover nudge */
  .turntable:not(:disabled):hover .record { filter: brightness(1.08); }

  /* ── player fade-in ── */
  .tt-player {
    max-height: 0;
    opacity: 0;
    transform: translateY(6px);
    transition: max-height 0.6s ease, opacity 0.8s ease 0.2s, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.2s;
  }
  .tt-player.on {
    max-height: 120px;
    opacity: 1;
    transform: translateY(0);
  }
  .tt-player iframe {
    display: block;
    width: 100%;
    height: 86px;
    border: 0;
    background: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .tonearm, .tt-player { transition: none; }
    .turntable[aria-pressed="true"] .record { animation: none; }
  }

  /* ── lyrics ── */
  .tt-lyrics {
    /* soft fade at top and bottom so lines drift in/out */
    mask-image: linear-gradient(to bottom, transparent 0, #000 22%, #000 78%, transparent 100%);
  }
  .tt-lyrics-inner {
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .tt-line {
    transition: color 0.3s ease, transform 0.3s ease, opacity 0.3s ease;
    opacity: 0.55;
    transform-origin: left center;
  }
  .tt-line.active {
    color: var(--foreground);
    opacity: 1;
    transform: scale(1.04);
    font-weight: 500;
  }
  /* non-LRC: plain list, scrollable */
  .tt-lyrics[data-lrc="false"] { mask-image: none; overflow-y: auto; }
  .tt-lyrics[data-lrc="false"] .tt-lyrics-inner { padding-block: 0.75rem; }
  .tt-lyrics[data-lrc="false"] .tt-line { opacity: 0.85; }
</style>

<script>
  const btn = document.getElementById('tt-btn') as HTMLButtonElement | null;
  const player = document.getElementById('tt-player');
  const status = document.getElementById('tt-status');

  // ── lyrics ────────────────────────────────────────────────────────────
  // The NetEase iframe is cross-origin, so we can't read its playhead. We run a
  // local clock that starts when the needle drops and pauses with the record.
  const lyricsBox = document.getElementById('tt-lyrics');
  const lyricsInner = document.getElementById('tt-lyrics-inner');
  const lines = lyricsInner
    ? (Array.from(lyricsInner.querySelectorAll('.tt-line')) as HTMLElement[])
    : [];
  const lrcLines = lines.filter((l) => l.dataset.t);
  let lyricTimer = 0;
  let lyricStart = 0;
  let curLine = -1;

  function resetLyrics() {
    curLine = -1;
    lines.forEach((l) => l.classList.remove('active'));
    if (lyricsInner) lyricsInner.style.transform = 'translateY(0)';
  }

  function tickLyrics() {
    if (!lrcLines.length) return;
    const t = (Date.now() - lyricStart) / 1000;
    let idx = 0;
    for (let i = 0; i < lrcLines.length; i++) {
      if (Number(lrcLines[i].dataset.t) <= t) idx = i;
      else break;
    }
    if (idx === curLine) return;
    curLine = idx;
    lines.forEach((l) => l.classList.remove('active'));
    const el = lrcLines[idx];
    el.classList.add('active');
    // center the active line: shift so it sits in the middle of the box
    const boxH = (lyricsBox?.clientHeight || 176) / 2;
    const lineTop = el.offsetTop + el.offsetHeight / 2;
    if (lyricsInner) lyricsInner.style.transform = `translateY(${boxH - lineTop}px)`;
  }

  function startLyrics() {
    resetLyrics();
    lyricStart = Date.now();
    clearInterval(lyricTimer);
    tickLyrics();
    lyricTimer = window.setInterval(tickLyrics, 300);
  }
  function stopLyrics() {
    clearInterval(lyricTimer);
  }

  if (btn && player && !btn.disabled) {
    let iframe: HTMLIFrameElement | null = null;
    let playing = false;

    function mount() {
      if (iframe) return;
      iframe = document.createElement('iframe');
      iframe.src = player!.dataset.src || '';
      iframe.title = '网易云音乐播放器';
      iframe.loading = 'eager';
      iframe.setAttribute('allow', 'autoplay; encrypted-media');
      iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-popups allow-forms');
      player!.appendChild(iframe);
    }

    function play() {
      playing = true;
      btn!.setAttribute('aria-pressed', 'true');
      btn!.removeAttribute('data-stopping');
      // Tonearm takes ~0.9s to land; reveal the player as the needle drops.
      setTimeout(() => {
        mount();
        player!.classList.add('on');
        player!.setAttribute('aria-hidden', 'false');
        if (status) status.textContent = '正在播放 · 再点一下唱片暂停';
        startLyrics();
      }, 500);
      if (status) status.textContent = '唱针落下…';
    }

    function pause() {
      playing = false;
      btn!.setAttribute('aria-pressed', 'false');
      btn!.setAttribute('data-stopping', 'true');
      stopLyrics();
      // Fade the player out, then drop the iframe so audio actually stops
      // (cross-origin iframes can't be paused from here).
      player!.classList.remove('on');
      player!.setAttribute('aria-hidden', 'true');
      if (status) status.textContent = '已暂停 · 点唱片继续';
      setTimeout(() => {
        if (iframe && !playing) {
          iframe.remove();
          iframe = null;
        }
        btn!.removeAttribute('data-stopping');
      }, 700);
    }

    btn.addEventListener('click', () => (playing ? pause() : play()));
  }
</script>
