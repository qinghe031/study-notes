---
// Cheering Gundam mascot (Build Strike style) — both arms raised, "加油!" pose.
// Pure inline SVG, no external assets. Click → bounce + an encouragement line.
const LINES = [
  '加油!',
  '今天也要好好学习!',
  '再读一遍就懂了。',
  '写下来,就记住了。',
  '休息一下也没关系。',
  '你已经比昨天多懂一点了。',
  '出击!',
  '不懂的地方正是进步的地方。',
];
---

<div id="mascot" class="fixed bottom-20 right-4 z-30 select-none sm:bottom-5 sm:right-20" aria-live="polite">
  <div id="mascot-bubble" class="card pointer-events-none absolute -top-2 right-2 w-max max-w-[11rem] -translate-y-full px-3 py-1.5 text-xs opacity-0 transition-all">
    加油!
    <span class="absolute -bottom-1.5 right-6 h-3 w-3 rotate-45 border-b border-r border-border bg-card"></span>
  </div>

  <button id="mascot-btn" type="button" aria-label="加油小人" class="mascot-body block h-36 w-28 cursor-pointer bg-transparent p-0 sm:h-40 sm:w-32">
    <svg viewBox="0 0 140 200" xmlns="http://www.w3.org/2000/svg" class="h-full w-full">
      <defs>
        <!-- white armor: top-lit -->
        <linearGradient id="mw" x1="0" y1="0" x2="0.4" y2="1">
          <stop offset="0" stop-color="#ffffff"/>
          <stop offset="0.55" stop-color="#eef1f4"/>
          <stop offset="1" stop-color="#cdd3da"/>
        </linearGradient>
        <linearGradient id="mw2" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#f7f8fa"/>
          <stop offset="1" stop-color="#b9c1ca"/>
        </linearGradient>
        <!-- blue chest -->
        <linearGradient id="mb" x1="0" y1="0" x2="0.3" y2="1">
          <stop offset="0" stop-color="#5a7fe0"/>
          <stop offset="0.6" stop-color="#3556c4"/>
          <stop offset="1" stop-color="#22399a"/>
        </linearGradient>
        <!-- red -->
        <linearGradient id="mr" x1="0" y1="0" x2="0.3" y2="1">
          <stop offset="0" stop-color="#e45561"/>
          <stop offset="0.6" stop-color="#c7303c"/>
          <stop offset="1" stop-color="#8f1e28"/>
        </linearGradient>
        <!-- yellow -->
        <linearGradient id="my" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffe066"/>
          <stop offset="1" stop-color="#e4af1c"/>
        </linearGradient>
        <!-- grey joints -->
        <linearGradient id="mg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#7c848f"/>
          <stop offset="1" stop-color="#454c56"/>
        </linearGradient>
        <radialGradient id="meye" cx="40%" cy="35%" r="70%">
          <stop offset="0" stop-color="#c8ffd2"/>
          <stop offset="0.5" stop-color="#5ee07a"/>
          <stop offset="1" stop-color="#1f8f3c"/>
        </radialGradient>
        <filter id="msh" x="-20%" y="-10%" width="140%" height="130%">
          <feDropShadow dx="0" dy="3" stdDeviation="2.2" flood-color="#1b222c" flood-opacity="0.28"/>
        </filter>
      </defs>

      <g filter="url(#msh)">

        <!-- ═══ BACKPACK (behind torso) ═══ -->
        <rect x="52" y="70" width="36" height="22" rx="3" fill="url(#mg)"/>
        <rect x="46" y="74" width="7" height="14" rx="2" fill="#5b636e"/>
        <rect x="87" y="74" width="7" height="14" rx="2" fill="#5b636e"/>

        <!-- ═══ LEGS ═══ -->
        <!-- hip joints -->
        <rect x="54" y="118" width="10" height="8" rx="2" fill="url(#mg)"/>
        <rect x="76" y="118" width="10" height="8" rx="2" fill="url(#mg)"/>

        <!-- left leg -->
        <g>
          <!-- thigh -->
          <path d="M50 122 L64 122 L63 148 L51 148 Z" fill="url(#mw)" stroke="#aab2bc" stroke-width="0.8"/>
          <path d="M53 124 L55 124 L54 146 L52 146 Z" fill="#fff" opacity="0.55"/>
          <!-- knee -->
          <rect x="50" y="146" width="14" height="7" rx="2" fill="url(#mg)"/>
          <path d="M51 144 L63 144 L62 150 L52 150 Z" fill="url(#mw2)" stroke="#aab2bc" stroke-width="0.7"/>
          <!-- shin -->
          <path d="M49 152 L65 152 L67 180 L47 180 Z" fill="url(#mw)" stroke="#aab2bc" stroke-width="0.8"/>
          <path d="M55 154 L59 154 L60 176 L54 176 Z" fill="#fff" opacity="0.4"/>
          <path d="M51 156 L53 156 L52 170 L50 170 Z" fill="#9aa3ad" opacity="0.5"/>
          <!-- ankle -->
          <rect x="52" y="178" width="10" height="5" fill="url(#mg)"/>
          <!-- foot -->
          <path d="M44 182 L66 182 L70 192 L41 192 Z" fill="url(#mr)" stroke="#7a1a22" stroke-width="0.8"/>
          <path d="M46 183 L64 183 L66 187 L45 187 Z" fill="#fff" opacity="0.15"/>
        </g>

        <!-- right leg -->
        <g>
          <path d="M76 122 L90 122 L89 148 L77 148 Z" fill="url(#mw)" stroke="#aab2bc" stroke-width="0.8"/>
          <path d="M79 124 L81 124 L80 146 L78 146 Z" fill="#fff" opacity="0.55"/>
          <rect x="76" y="146" width="14" height="7" rx="2" fill="url(#mg)"/>
          <path d="M77 144 L89 144 L88 150 L78 150 Z" fill="url(#mw2)" stroke="#aab2bc" stroke-width="0.7"/>
          <path d="M75 152 L91 152 L93 180 L73 180 Z" fill="url(#mw)" stroke="#aab2bc" stroke-width="0.8"/>
          <path d="M81 154 L85 154 L86 176 L80 176 Z" fill="#fff" opacity="0.4"/>
          <path d="M87 156 L89 156 L90 170 L88 170 Z" fill="#9aa3ad" opacity="0.5"/>
          <rect x="78" y="178" width="10" height="5" fill="url(#mg)"/>
          <path d="M74 182 L96 182 L99 192 L70 192 Z" fill="url(#mr)" stroke="#7a1a22" stroke-width="0.8"/>
          <path d="M76 183 L94 183 L95 187 L74 187 Z" fill="#fff" opacity="0.15"/>
        </g>

        <!-- ═══ WAIST / SKIRT ═══ -->
        <!-- side skirts -->
        <path d="M44 104 L54 104 L52 122 L42 120 Z" fill="url(#mw)" stroke="#aab2bc" stroke-width="0.8"/>
        <path d="M96 104 L86 104 L88 122 L98 120 Z" fill="url(#mw)" stroke="#aab2bc" stroke-width="0.8"/>
        <!-- front skirts -->
        <path d="M54 104 L68 104 L67 122 L53 122 Z" fill="url(#mw)" stroke="#aab2bc" stroke-width="0.8"/>
        <path d="M72 104 L86 104 L87 122 L73 122 Z" fill="url(#mw)" stroke="#aab2bc" stroke-width="0.8"/>
        <path d="M57 106 L59 106 L58 118 L56 118 Z" fill="#fff" opacity="0.5"/>
        <path d="M81 106 L83 106 L84 118 L82 118 Z" fill="#fff" opacity="0.5"/>
        <!-- center crotch (red) -->
        <path d="M66 104 L74 104 L75 124 L65 124 Z" fill="url(#mr)"/>
        <!-- belt -->
        <rect x="52" y="100" width="36" height="5" rx="1" fill="url(#mg)"/>
        <rect x="66" y="99" width="8" height="7" rx="1" fill="url(#my)"/>

        <!-- ═══ TORSO ═══ -->
        <!-- abdomen (red) -->
        <path d="M56 86 L84 86 L86 100 L54 100 Z" fill="url(#mr)"/>
        <path d="M58 87 L60 87 L59 99 L57 99 Z" fill="#fff" opacity="0.25"/>
        <!-- chest (blue) -->
        <path d="M44 64 L96 64 L98 82 L88 90 L52 90 L42 82 Z" fill="url(#mb)" stroke="#1c2f7d" stroke-width="0.9"/>
        <!-- chest highlight -->
        <path d="M46 65 L94 65 L95 70 L45 70 Z" fill="#fff" opacity="0.18"/>
        <!-- chest vents (yellow) -->
        <rect x="49" y="70" width="14" height="9" rx="1.5" fill="url(#my)"/>
        <rect x="77" y="70" width="14" height="9" rx="1.5" fill="url(#my)"/>
        <g stroke="#9a6f0c" stroke-width="0.8" opacity="0.7">
          <line x1="49" y1="73" x2="63" y2="73"/><line x1="49" y1="76" x2="63" y2="76"/>
          <line x1="77" y1="73" x2="91" y2="73"/><line x1="77" y1="76" x2="91" y2="76"/>
        </g>
        <!-- center chest block -->
        <path d="M65 66 L75 66 L76 90 L64 90 Z" fill="#17287a"/>
        <rect x="67" y="68" width="6" height="18" fill="url(#mb)" opacity="0.8"/>
        <!-- collar -->
        <path d="M58 60 L82 60 L84 65 L56 65 Z" fill="url(#mw2)" stroke="#aab2bc" stroke-width="0.7"/>

        <!-- ═══ LEFT ARM (raised) ═══ -->
        <g class="arm arm-l">
          <!-- upper arm -->
          <path d="M36 44 L48 44 L49 70 L35 70 Z" fill="url(#mw)" stroke="#aab2bc" stroke-width="0.8"/>
          <path d="M39 46 L41 46 L40 68 L38 68 Z" fill="#fff" opacity="0.5"/>
          <!-- elbow -->
          <rect x="36" y="40" width="12" height="6" rx="2" fill="url(#mg)"/>
          <!-- forearm -->
          <path d="M34 22 L50 22 L50 42 L34 42 Z" fill="url(#mw)" stroke="#aab2bc" stroke-width="0.8"/>
          <path d="M37 24 L39 24 L39 40 L37 40 Z" fill="#fff" opacity="0.5"/>
          <!-- red forearm band -->
          <rect x="34" y="30" width="16" height="7" fill="url(#mr)"/>
          <!-- wrist -->
          <rect x="37" y="19" width="10" height="4" fill="url(#mg)"/>
          <!-- fist -->
          <rect x="35" y="6" width="14" height="14" rx="3" fill="url(#mw2)" stroke="#aab2bc" stroke-width="0.8"/>
          <g stroke="#8b949f" stroke-width="0.9">
            <line x1="38" y1="9" x2="38" y2="17"/><line x1="42" y1="9" x2="42" y2="17"/><line x1="46" y1="9" x2="46" y2="17"/>
          </g>
          <!-- thumb -->
          <rect x="47" y="11" width="4" height="7" rx="1.5" fill="url(#mw2)" stroke="#aab2bc" stroke-width="0.7"/>
        </g>

        <!-- ═══ RIGHT ARM (raised) ═══ -->
        <g class="arm arm-r">
          <path d="M92 44 L104 44 L105 70 L91 70 Z" fill="url(#mw)" stroke="#aab2bc" stroke-width="0.8"/>
          <path d="M99 46 L101 46 L102 68 L100 68 Z" fill="#fff" opacity="0.5"/>
          <rect x="92" y="40" width="12" height="6" rx="2" fill="url(#mg)"/>
          <path d="M90 22 L106 22 L106 42 L90 42 Z" fill="url(#mw)" stroke="#aab2bc" stroke-width="0.8"/>
          <path d="M101 24 L103 24 L103 40 L101 40 Z" fill="#fff" opacity="0.5"/>
          <rect x="90" y="30" width="16" height="7" fill="url(#mr)"/>
          <rect x="93" y="19" width="10" height="4" fill="url(#mg)"/>
          <rect x="91" y="6" width="14" height="14" rx="3" fill="url(#mw2)" stroke="#aab2bc" stroke-width="0.8"/>
          <g stroke="#8b949f" stroke-width="0.9">
            <line x1="94" y1="9" x2="94" y2="17"/><line x1="98" y1="9" x2="98" y2="17"/><line x1="102" y1="9" x2="102" y2="17"/>
          </g>
          <rect x="89" y="11" width="4" height="7" rx="1.5" fill="url(#mw2)" stroke="#aab2bc" stroke-width="0.7"/>
        </g>

        <!-- ═══ SHOULDER ARMOR (on top of arms) ═══ -->
        <!-- left -->
        <path d="M30 58 L46 54 L52 64 L50 76 L36 78 L28 70 Z" fill="url(#mw)" stroke="#aab2bc" stroke-width="0.9"/>
        <path d="M33 59 L45 56 L49 63 L47 70 L37 71 L32 66 Z" fill="url(#mr)"/>
        <path d="M34 60 L44 57 L46 60 L35 63 Z" fill="#fff" opacity="0.3"/>
        <!-- right -->
        <path d="M110 58 L94 54 L88 64 L90 76 L104 78 L112 70 Z" fill="url(#mw)" stroke="#aab2bc" stroke-width="0.9"/>
        <path d="M107 59 L95 56 L91 63 L93 70 L103 71 L108 66 Z" fill="url(#mr)"/>
        <path d="M106 60 L96 57 L94 60 L105 63 Z" fill="#fff" opacity="0.3"/>

        <!-- ═══ HEAD ═══ -->
        <g class="head">
          <!-- neck -->
          <rect x="65" y="54" width="10" height="8" fill="url(#mg)"/>
          <!-- V-fin: four blades, big and swept back like the kit -->
          <path d="M70 30 L46 12 L60 34 Z" fill="url(#my)" stroke="#a97c10" stroke-width="0.7"/>
          <path d="M70 30 L94 12 L80 34 Z" fill="url(#my)" stroke="#a97c10" stroke-width="0.7"/>
          <path d="M70 30 L50 24 L62 36 Z" fill="url(#my)" stroke="#a97c10" stroke-width="0.6" opacity="0.9"/>
          <path d="M70 30 L90 24 L78 36 Z" fill="url(#my)" stroke="#a97c10" stroke-width="0.6" opacity="0.9"/>
          <!-- fin highlights -->
          <path d="M70 30 L48 14 L56 22 Z" fill="#fff" opacity="0.3"/>
          <path d="M70 30 L92 14 L84 22 Z" fill="#fff" opacity="0.3"/>
          <!-- center crest (red gem) -->
          <path d="M66 30 L74 30 L73 36 L67 36 Z" fill="url(#mr)"/>
          <ellipse cx="70" cy="32.5" rx="2" ry="1" fill="#fff" opacity="0.6"/>
          <!-- helmet -->
          <path d="M56 34 L84 34 L87 46 L84 58 L56 58 L53 46 Z" fill="url(#mw)" stroke="#aab2bc" stroke-width="0.9"/>
          <path d="M58 35 L82 35 L84 40 L56 40 Z" fill="#fff" opacity="0.45"/>
          <!-- face plate (dark) -->
          <path d="M58 42 L82 42 L83 50 L57 50 Z" fill="#232a33"/>
          <!-- eyes -->
          <path d="M59 44 L67 44 L66 48 L59 47 Z" fill="url(#meye)" class="eye"/>
          <path d="M81 44 L73 44 L74 48 L81 47 Z" fill="url(#meye)" class="eye"/>
          <!-- brow -->
          <path d="M57 42 L83 42 L82 44 L58 44 Z" fill="#111519"/>
          <!-- cheek vents (red) -->
          <path d="M54 44 L58 44 L58 54 L55 54 Z" fill="url(#mr)"/>
          <path d="M86 44 L82 44 L82 54 L85 54 Z" fill="url(#mr)"/>
          <!-- chin / mouth block -->
          <path d="M63 50 L77 50 L76 57 L64 57 Z" fill="url(#mw2)" stroke="#aab2bc" stroke-width="0.7"/>
          <g stroke="#8b949f" stroke-width="0.8">
            <line x1="66" y1="52" x2="66" y2="56"/><line x1="70" y1="52" x2="70" y2="56"/><line x1="74" y1="52" x2="74" y2="56"/>
          </g>
          <!-- ear/side vents -->
          <rect x="52" y="46" width="3" height="6" rx="1" fill="url(#mg)"/>
          <rect x="85" y="46" width="3" height="6" rx="1" fill="url(#mg)"/>
        </g>
      </g>
    </svg>
  </button>
</div>

<style>
  .mascot-body {
    animation: mascot-bob 3.2s ease-in-out infinite;
    transform-origin: 50% 100%;
  }
  @keyframes mascot-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-4px); }
  }

  /* Arms pump — the "加油!" wave, alternating */
  .arm {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: mascot-pump-l 1.6s ease-in-out infinite;
  }
  .arm-r { animation-name: mascot-pump-r; animation-delay: 0.8s; }
  @keyframes mascot-pump-l {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-6px) rotate(-4deg); }
  }
  @keyframes mascot-pump-r {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-6px) rotate(4deg); }
  }

  /* Eyes glow-pulse */
  .eye { animation: mascot-glow 2.4s ease-in-out infinite; }
  @keyframes mascot-glow {
    0%, 100% { filter: brightness(1); }
    50%      { filter: brightness(1.5) drop-shadow(0 0 2px #5ee07a); }
  }

  .mascot-body:hover { animation-play-state: paused; transform: translateY(-2px) scale(1.04); }

  .mascot-body.cheer { animation: mascot-cheer 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes mascot-cheer {
    0%   { transform: translateY(0) scale(1); }
    40%  { transform: translateY(-12px) scale(1.08); }
    100% { transform: translateY(0) scale(1); }
  }

  #mascot-bubble.show { opacity: 1; transform: translateY(calc(-100% - 6px)); }

  @media (prefers-reduced-motion: reduce) {
    .mascot-body, .arm, .eye { animation: none !important; }
  }
</style>

<script define:vars={{ LINES }}>
  const btn = document.getElementById('mascot-btn');
  const bubble = document.getElementById('mascot-bubble');
  let timer = 0;
  let last = -1;

  function say(text) {
    if (!bubble) return;
    bubble.firstChild.textContent = text;
    bubble.classList.add('show');
    clearTimeout(timer);
    timer = setTimeout(() => bubble.classList.remove('show'), 2200);
  }

  btn?.addEventListener('click', () => {
    let i;
    do { i = Math.floor(Math.random() * LINES.length); } while (i === last && LINES.length > 1);
    last = i;
    say(LINES[i]);
    btn.classList.remove('cheer');
    void btn.offsetWidth;
    btn.classList.add('cheer');
  });

  setTimeout(() => say(LINES[0]), 900);
</script>
