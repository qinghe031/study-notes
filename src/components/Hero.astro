---
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  subtitle?: string;
  eyebrow?: string;
}
const { title = SITE.title, subtitle = SITE.slogan, eyebrow } = Astro.props;
---

<section class="reveal py-8 md:py-10">
  {eyebrow && <p class="mb-2 text-xs uppercase tracking-[0.2em] text-muted-foreground">{eyebrow}</p>}
  <h1 class="serif text-2xl md:text-3xl">{title}</h1>
  {subtitle && <p class="mt-3 max-w-2xl text-base text-muted-foreground md:text-lg">{subtitle}</p>}
</section>
