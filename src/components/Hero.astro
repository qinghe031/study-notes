---
import { SITE } from '../lib/site';
import Countdowns from './Countdowns.astro';

interface Props {
  title?: string;
  subtitle?: string;
  eyebrow?: string;
  /** Show the countdown pills beside the title (homepage only). */
  countdowns?: boolean;
}
const { title = SITE.title, subtitle = SITE.slogan, eyebrow, countdowns = false } = Astro.props;
---

<section class="reveal py-12 md:py-16">
  {eyebrow && <p class="mb-2 text-xs uppercase tracking-[0.2em] text-muted-foreground">{eyebrow}</p>}
  <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
    <h1 class="text-3xl font-semibold tracking-tight md:text-5xl">
      <span class="gradient-text">{title}</span>
    </h1>
    {countdowns && <Countdowns />}
  </div>
  {subtitle && <p class="mt-3 max-w-2xl text-base text-muted-foreground md:text-lg">{subtitle}</p>}
</section>
