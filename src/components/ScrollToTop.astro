<button
  id="scroll-top"
  aria-label="回到顶部"
  class="card fixed bottom-5 right-5 z-40 flex h-8 w-8 items-center justify-center text-muted-foreground opacity-0 shadow-md transition-all hover:text-foreground pointer-events-none"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
</button>

<script>
  const el = document.getElementById('scroll-top');
  const update = () => {
    const show = window.scrollY > 400;
    el?.classList.toggle('opacity-0', !show);
    el?.classList.toggle('pointer-events-none', !show);
  };
  window.addEventListener('scroll', update, { passive: true });
  update();
  el?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>
