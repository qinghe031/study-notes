---
// Countdown card — big number, the date, a line, a faint mountain in the corner.
// Shows the nearest upcoming event; flip through others with the arrows. Local-first.
import { COUNTDOWNS } from '../lib/site';
const seed = JSON.stringify(COUNTDOWNS);
---

<section id="countdowns" class="cd-card card reveal" data-seed={seed}>
  <header class="cd-head">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
    <span id="cd-label" class="cd-label" contenteditable="true" spellcheck="false">距离下次旅行还有</span>
  </header>

  <div class="cd-num-row">
    <span id="cd-num" class="cd-num">—</span>
    <span class="cd-unit">天</span>
  </div>

  <div class="cd-rule"></div>
  <p id="cd-date" class="cd-date">—</p>
  <p id="cd-note" class="cd-note" contenteditable="true" spellcheck="false"></p>

  <svg class="cd-mountain" viewBox="0 0 200 60" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round">
    <path d="M0 58 L40 26 L62 40 L90 12 L118 36 L136 24 L170 50 L200 40" opacity="0.35"/>
    <path d="M30 58 L70 34 L100 52 L140 30 L200 58" opacity="0.2"/>
  </svg>

  <div class="cd-nav">
    <button type="button" id="cd-prev" class="cd-arrow" aria-label="上一个">‹</button>
    <span id="cd-count" class="cd-counter"></span>
    <button type="button" id="cd-next" class="cd-arrow" aria-label="下一个">›</button>
    <span class="mx-1 h-3 w-px bg-border"></span>
    <button type="button" id="cd-add" class="cd-tool" title="加一个">＋</button>
    <button type="button" id="cd-edit" class="cd-tool" title="改日期">⟲</button>
    <button type="button" id="cd-del" class="cd-tool" title="移除">✕</button>
  </div>
</section>

<style>
  .cd-card { position: relative; padding: 1.25rem 1.35rem 1rem; min-height: 12.5rem; overflow: hidden; background: color-mix(in srgb, var(--card) 85%, var(--primary) 6%); }
  .cd-head { display: flex; align-items: center; gap: 0.5rem; color: var(--ink-soft); font-size: 0.88rem; }
  .cd-label { outline: none; }
  .cd-label:focus { box-shadow: inset 0 -1px 0 var(--primary); }
  .cd-num-row { display: flex; align-items: baseline; gap: 0.5rem; margin-top: 0.9rem; }
  .cd-num { font-family: var(--font-serif); font-size: 3rem; line-height: 1; font-weight: 500; letter-spacing: -0.01em; color: var(--foreground); }
  .cd-unit { font-size: 0.9rem; color: var(--ink-soft); }
  .cd-rule { width: 2.5rem; height: 1px; background: var(--border); margin: 0.8rem 0 0.6rem; }
  .cd-date { font-size: 0.85rem; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .cd-note { font-size: 0.8rem; color: var(--muted-foreground); margin-top: 0.15rem; outline: none; min-height: 1.2em; }
  .cd-note:empty::before { content: '写一句话…'; opacity: 0.5; }
  .cd-note:focus { box-shadow: inset 0 -1px 0 var(--primary); }
  .cd-mountain { position: absolute; right: 0.5rem; bottom: 2.2rem; width: 7.5rem; color: var(--ink-soft); pointer-events: none; }
  .cd-card.soon .cd-num { color: var(--primary); }
  .cd-card.past .cd-num { opacity: 0.45; }
  .cd-nav { display: flex; align-items: center; justify-content: flex-end; gap: 0.25rem; margin-top: 0.9rem; }
  .cd-arrow, .cd-tool { width: 1.6rem; height: 1.6rem; border-radius: 999px; font-size: 0.9rem; line-height: 1; color: var(--muted-foreground); transition: color 0.15s, background-color 0.15s; }
  .cd-arrow:hover, .cd-tool:hover { color: var(--foreground); background: var(--muted); }
  .cd-arrow:disabled { opacity: 0.3; pointer-events: none; }
  .cd-counter { font-size: 0.7rem; color: var(--muted-foreground); min-width: 2rem; text-align: center; font-variant-numeric: tabular-nums; }
  .cd-tool { font-size: 0.75rem; }
</style>

<script>
  import { load, setCountdowns, seedMisc, uid, daysUntil } from '../lib/notebook';

  const root = document.getElementById('countdowns')!;
  const labelEl = document.getElementById('cd-label')!;
  const numEl = document.getElementById('cd-num')!;
  const dateEl = document.getElementById('cd-date')!;
  const noteEl = document.getElementById('cd-note')!;
  const counter = document.getElementById('cd-count')!;
  const prev = document.getElementById('cd-prev') as HTMLButtonElement;
  const next = document.getElementById('cd-next') as HTMLButtonElement;
  let idx = 0;

  seedMisc([], JSON.parse(root.dataset.seed || '[]'));

  const list = () => load().countdowns;
  function show(i: number) {
    const l = list();
    if (!l.length) { labelEl.textContent = '还没有倒计时'; numEl.textContent = '—'; dateEl.textContent = '点 ＋ 加一个'; noteEl.textContent = ''; counter.textContent = '0 / 0'; prev.disabled = next.disabled = true; root.classList.remove('soon', 'past'); return; }
    idx = Math.max(0, Math.min(i, l.length - 1));
    const c = l[idx];
    const d = daysUntil(c.date);
    labelEl.textContent = c.label;
    numEl.textContent = String(Math.abs(d));
    dateEl.textContent = c.date;
    noteEl.textContent = c.note || '';
    root.classList.toggle('soon', d >= 0 && d <= 7);
    root.classList.toggle('past', d < 0);
    counter.textContent = `${idx + 1} / ${l.length}`;
    prev.disabled = idx === 0; next.disabled = idx === l.length - 1;
  }
  function commit() {
    const l = list(); if (!l[idx]) return;
    l[idx].label = labelEl.textContent?.trim() || l[idx].label;
    l[idx].note = noteEl.textContent?.trim() || '';
    setCountdowns(l);
  }
  // Sort upcoming first so the card opens on the nearest event.
  (function sortOnce() { const l = list(); if (l.length > 1) { l.sort((a, b) => daysUntil(a.date) - daysUntil(b.date)); setCountdowns(l); } })();

  let t = 0;
  for (const el of [labelEl, noteEl]) {
    el.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(commit, 400); });
    el.addEventListener('blur', commit);
    el.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === 'Escape') { e.preventDefault(); (e.target as HTMLElement).blur(); } });
  }
  prev.onclick = () => { commit(); show(idx - 1); };
  next.onclick = () => { commit(); show(idx + 1); };
  (document.getElementById('cd-add') as HTMLButtonElement).onclick = () => {
    const label = prompt('倒计时事件(例如:距离下次旅行还有)', '距离 … 还有'); if (!label) return;
    const date = prompt('日期(YYYY-MM-DD)', new Date(Date.now() + 30 * 86400000).toISOString().slice(0, 10));
    if (!date || !/^\d{4}-\d{2}-\d{2}$/.test(date)) return;
    const l = list(); l.push({ id: uid(), label, date, note: '' }); setCountdowns(l); show(l.length - 1);
  };
  (document.getElementById('cd-edit') as HTMLButtonElement).onclick = () => {
    const l = list(); if (!l[idx]) return;
    const nd = prompt('新的日期(YYYY-MM-DD)', l[idx].date);
    if (nd && /^\d{4}-\d{2}-\d{2}$/.test(nd)) { l[idx].date = nd; setCountdowns(l); show(idx); }
  };
  (document.getElementById('cd-del') as HTMLButtonElement).onclick = () => {
    const l = list(); if (!l.length) return;
    if (!confirm('移除这个倒计时?')) return;
    l.splice(idx, 1); setCountdowns(l); show(Math.min(idx, l.length - 1));
  };
  show(0);
</script>
