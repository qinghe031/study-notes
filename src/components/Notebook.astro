---
// The notebook — fullscreen writing surface with live Markdown preview.
// Open it, write, close it: everything autosaves locally as you type.
// "同步" is a separate, deliberate step that publishes to GitHub.
//
// Mounted once in BaseLayout. Others call window.__notebook.open(slug?) / .openList() / .syncAll()
import { getNotes, getCategories } from '../lib/content';
const categories = getCategories(await getNotes()).map((c) => c.name);
---

<!-- ═══ Editor (fullscreen) ═══════════════════════════════════════════════ -->
<div id="nb-sheet" class="nb-full hidden" role="dialog" aria-modal="true" aria-label="笔记本">
  <header class="nb-bar">
    <div class="flex min-w-0 items-center gap-3">
      <button id="nb-close" type="button" class="nb-iconbtn" aria-label="合上" title="合上(Esc)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </button>
      <span class="serif text-base">笔记本</span>
      <span id="nb-state" class="truncate text-xs text-muted-foreground">新的一页</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span id="nb-saved" class="hidden text-xs text-muted-foreground sm:inline"></span>
      <button id="nb-list" type="button" class="nb-ghost">本子里的其他页</button>
      <button id="nb-delete" type="button" class="nb-ghost nb-danger hidden">撕掉这页</button>
      <button id="nb-sync" type="button" class="nb-primary hidden" title="把这一页发布到网站">同步到网站</button>
    </div>
  </header>

  <form id="nb-form" class="nb-body" autocomplete="off">
    <input name="title" placeholder="今天想写点什么" class="nb-title" />

    <div class="nb-meta">
      <input name="date" type="date" title="日期" />
      <input name="category" placeholder="分类" list="nb-cats" />
      <input name="tags" placeholder="标签,逗号分隔" />
      <input name="summary" placeholder="一句话摘要(可空)" class="nb-meta-wide" />
      <label class="nb-flag nb-flag--draft" title="勾上:同步后也不会出现在网站上,只有你自己能看到"><input name="draft" type="checkbox" /> 草稿(不公开)</label>
      <label class="nb-flag">置顶 <input name="sticky" type="number" min="0" value="0" class="nb-mini" /></label>
    </div>

    <div class="nb-toolbar" role="toolbar" aria-label="格式">
      <button type="button" data-md="h2" title="二级标题">H2</button>
      <button type="button" data-md="h3" title="三级标题">H3</button>
      <span class="nb-sep"></span>
      <button type="button" data-md="bold" title="加粗 (Ctrl+B)"><b>B</b></button>
      <button type="button" data-md="italic" title="斜体 (Ctrl+I)"><i>I</i></button>
      <button type="button" data-md="code" title="行内代码">&lt;/&gt;</button>
      <span class="nb-sep"></span>
      <button type="button" data-md="ul" title="无序列表">• 列表</button>
      <button type="button" data-md="ol" title="有序列表">1. 列表</button>
      <button type="button" data-md="todo" title="待办">☐ 待办</button>
      <button type="button" data-md="quote" title="引用">❝ 引用</button>
      <span class="nb-sep"></span>
      <button type="button" data-md="link" title="链接">🔗</button>
      <button type="button" data-md="image" title="图片">🖼</button>
      <button type="button" data-md="codeblock" title="代码块">```</button>
      <button type="button" data-md="hr" title="分隔线">—</button>
      <span class="ml-auto flex items-center gap-1">
        <button type="button" id="nb-view-write" class="nb-view" aria-pressed="true" title="只写">写</button>
        <button type="button" id="nb-view-split" class="nb-view" aria-pressed="false" title="写 + 预览">分栏</button>
        <button type="button" id="nb-view-read" class="nb-view" aria-pressed="false" title="只看预览">预览</button>
      </span>
    </div>

    <div id="nb-panes" class="nb-panes" data-view="write">
      <textarea name="body" placeholder="随便写。想到哪写到哪,下次打开接着写。&#10;&#10;Markdown 会实时渲染:## 标题、**加粗**、- 列表、`代码`、$公式$、![图](./images/x.png)" spellcheck="false"></textarea>
      <div id="nb-preview" class="nb-preview prose prose-neutral max-w-none dark:prose-invert"></div>
    </div>

    <footer class="nb-foot">
      <span id="nb-slug" class="font-mono text-[11px] text-muted-foreground"></span>
      <span id="nb-count" class="text-[11px] text-muted-foreground"></span>
    </footer>
  </form>
</div>

<!-- ═══ Notes list ════════════════════════════════════════════════════════ -->
<div id="nb-list-sheet" class="nb-overlay hidden" role="dialog" aria-modal="true" aria-label="本子里的页">
  <div id="nb-list-backdrop" class="nb-backdrop"></div>
  <div class="nb-card nb-card--sm">
    <header class="nb-head">
      <div>
        <h2 class="serif text-base">本子里的页</h2>
        <p id="nb-list-sub" class="text-xs text-muted-foreground"></p>
      </div>
      <button id="nb-list-close" type="button" aria-label="关闭" class="nb-iconbtn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </header>
    <div id="nb-list-body" class="max-h-[60vh] overflow-y-auto px-2 py-2"></div>
    <footer class="nb-foot nb-foot--card">
      <button id="nb-new" type="button" class="nb-ghost">+ 新的一页</button>
      <button id="nb-sync-all" type="button" class="nb-primary hidden">同步全部</button>
    </footer>
  </div>
</div>

<!-- ═══ Token ═════════════════════════════════════════════════════════════ -->
<div id="tk-sheet" class="nb-overlay nb-overlay--top hidden" role="dialog" aria-modal="true" aria-label="设置 GitHub 令牌">
  <div id="tk-backdrop" class="nb-backdrop"></div>
  <div class="nb-card nb-card--sm">
    <header class="nb-head">
      <div>
        <h2 class="serif text-base">同步到网站需要一个 GitHub 令牌</h2>
        <p class="text-xs text-muted-foreground">只需设置一次,只存在你这台电脑的浏览器里。</p>
      </div>
    </header>
    <div class="space-y-4 px-6 py-5 text-sm">
      <ol class="space-y-2.5 text-muted-foreground">
        <li class="flex gap-3"><span class="nb-step">1</span><span>点下面的按钮打开 GitHub 生成页(新标签页)。</span></li>
        <li class="flex gap-3"><span class="nb-step">2</span><span><b class="text-foreground">Repository access</b> 选 Only select repositories → 勾 <code id="tk-repo" class="rounded bg-muted px-1"></code></span></li>
        <li class="flex gap-3"><span class="nb-step">3</span><span><b class="text-foreground">Permissions → Contents</b> 选 <b class="text-foreground">Read and write</b>,然后 Generate token</span></li>
        <li class="flex gap-3"><span class="nb-step">4</span><span>复制令牌,回到这里粘贴。</span></li>
      </ol>
      <a id="tk-link" href="#" target="_blank" rel="noopener" class="nb-primary inline-flex w-full justify-center gap-2">
        打开 GitHub 令牌生成页
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
      </a>
      <input id="tk-input" type="password" placeholder="粘贴令牌:github_pat_… 或 ghp_…" autocomplete="off" spellcheck="false" class="nb-inp" />
      <p id="tk-msg" class="min-h-[1.2em] text-xs text-muted-foreground"></p>
    </div>
    <footer class="nb-foot nb-foot--card">
      <button id="tk-clear" type="button" class="nb-ghost">清除已保存的令牌</button>
      <div class="flex gap-2">
        <button id="tk-cancel" type="button" class="nb-ghost">取消</button>
        <button id="tk-ok" type="button" class="nb-primary">验证并保存</button>
      </div>
    </footer>
  </div>
</div>

<datalist id="nb-cats">{categories.map((c) => <option value={c} />)}</datalist>

<style>
  /* ── fullscreen editor ── */
  .nb-full { position: fixed; inset: 0; z-index: 75; display: flex; flex-direction: column; background: var(--background); }
  .nb-full.hidden { display: none; }
  .nb-bar { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.6rem 1.25rem; border-bottom: 1px solid var(--border); background: var(--card); }
  .nb-body { display: flex; flex-direction: column; flex: 1; min-height: 0; width: 100%; max-width: 76rem; margin-inline: auto; padding: 1.25rem 1.5rem 0.75rem; gap: 0.7rem; }

  .nb-title {
    width: 100%; padding: 0.3rem 0; border: 0; border-bottom: 1px solid var(--border);
    background: transparent; color: var(--foreground); outline: none;
    font-family: var(--font-serif); font-size: 1.75rem; font-weight: 500; letter-spacing: 0.02em;
    transition: border-color 0.2s;
  }
  .nb-title:focus { border-bottom-color: var(--primary); }
  .nb-title::placeholder { color: var(--muted-foreground); opacity: 0.5; }

  .nb-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; }
  .nb-meta input:not([type=checkbox]), .nb-inp {
    padding: 0.35rem 0.6rem; border: 1px solid var(--border); border-radius: 0.5rem;
    background: var(--card); color: var(--foreground); font-size: 0.8rem; outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .nb-meta input[name=date] { width: 9rem; }
  .nb-meta input[name=category] { width: 8rem; }
  .nb-meta input[name=tags] { width: 12rem; }
  .nb-meta-wide { flex: 1; min-width: 12rem; }
  .nb-flag { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; color: var(--muted-foreground); }
  .nb-flag input[type=checkbox] { accent-color: var(--primary); }
  .nb-flag--draft:has(input:checked) { color: #8a6a14; background: color-mix(in srgb, #c9a040 18%, transparent); padding: 0.2rem 0.5rem; border-radius: 0.4rem; }
  .nb-mini { width: 3.2rem !important; padding: 0.25rem 0.35rem !important; text-align: center; }
  .nb-inp { width: 100%; }
  .nb-meta input:focus, .nb-inp:focus { border-color: var(--primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 14%, transparent); }
  .nb-meta input::placeholder, .nb-inp::placeholder { color: var(--muted-foreground); opacity: 0.55; }

  .nb-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.15rem; padding: 0.25rem 0.35rem; border: 1px solid var(--border); border-radius: 0.6rem; background: var(--card); }
  .nb-toolbar button { padding: 0.25rem 0.55rem; border-radius: 0.4rem; font-size: 0.75rem; color: var(--ink-soft); transition: background-color 0.12s, color 0.12s; }
  .nb-toolbar button:hover { background: var(--muted); color: var(--foreground); }
  .nb-sep { width: 1px; height: 1rem; background: var(--border); margin: 0 0.25rem; }
  .nb-view[aria-pressed=true] { background: var(--muted); color: var(--foreground); }

  .nb-panes { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
  .nb-panes[data-view=split] { grid-template-columns: 1fr 1fr; }
  .nb-panes[data-view=write] .nb-preview { display: none; }
  .nb-panes[data-view=read] textarea { display: none; }
  .nb-panes textarea {
    width: 100%; height: 100%; min-height: 20rem; resize: none; padding: 1rem 1.1rem;
    border: 1px solid var(--border); border-radius: 0.75rem; background: var(--card); color: var(--foreground); outline: none;
    font-family: var(--font-mono); font-size: 0.92rem; line-height: 1.8; tab-size: 2;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .nb-panes textarea:focus { border-color: var(--primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 12%, transparent); }
  .nb-panes textarea::placeholder { color: var(--muted-foreground); opacity: 0.5; }
  .nb-preview { height: 100%; min-height: 20rem; overflow-y: auto; padding: 1rem 1.4rem; border: 1px solid var(--border); border-radius: 0.75rem; background: var(--card); }
  .nb-preview:empty::before { content: '预览会出现在这里'; color: var(--muted-foreground); opacity: 0.5; font-size: 0.85rem; }

  .nb-foot { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.25rem 0.15rem; }
  .nb-foot--card { padding: 0.75rem 1.5rem; border-top: 1px solid var(--border); }

  /* ── overlays (list, token) ── */
  .nb-overlay { position: fixed; inset: 0; z-index: 80; display: flex; align-items: center; justify-content: center; padding: 1rem; }
  .nb-overlay--top { z-index: 85; }
  .nb-overlay.hidden { display: none; }
  .nb-backdrop { position: absolute; inset: 0; background: color-mix(in srgb, var(--background) 72%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .nb-card { position: relative; display: flex; flex-direction: column; width: 100%; max-width: 28rem; max-height: 90vh; overflow: hidden; border: 1px solid var(--border); border-radius: 1rem; background: var(--card); box-shadow: 0 30px 80px -24px rgba(27, 34, 44, 0.4); animation: nb-in 0.25s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes nb-in { from { opacity: 0; transform: translateY(12px) scale(0.98); } to { opacity: 1; transform: none; } }
  .nb-head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 1rem 1.5rem; border-bottom: 1px solid var(--border); }

  .nb-iconbtn { padding: 0.45rem; border-radius: 0.5rem; color: var(--muted-foreground); }
  .nb-iconbtn:hover { background: var(--muted); color: var(--foreground); }
  .nb-primary { padding: 0.45rem 0.95rem; border-radius: 0.6rem; background: var(--primary); color: var(--primary-foreground); font-size: 0.8rem; font-weight: 600; transition: opacity 0.15s, transform 0.15s; }
  .nb-primary:hover { opacity: 0.92; }
  .nb-primary:active { transform: scale(0.98); }
  .nb-primary:disabled { opacity: 0.5; cursor: wait; }
  .nb-primary.hidden { display: none; }
  .nb-ghost { padding: 0.4rem 0.65rem; border-radius: 0.5rem; font-size: 0.78rem; color: var(--muted-foreground); transition: background-color 0.15s, color 0.15s; }
  .nb-ghost:hover { background: var(--muted); color: var(--foreground); }
  .nb-ghost.hidden { display: none; }
  .nb-danger { color: #b5434e; }
  .nb-danger:hover { background: color-mix(in srgb, #b5434e 12%, transparent); color: #b5434e; }
  .nb-step { display: grid; place-items: center; flex-shrink: 0; width: 1.4rem; height: 1.4rem; border-radius: 999px; background: color-mix(in srgb, var(--primary) 16%, transparent); color: var(--primary); font-size: 0.7rem; font-weight: 700; }

  @media (max-width: 760px) {
    .nb-panes[data-view=split] { grid-template-columns: 1fr; }
    .nb-body { padding: 0.9rem 0.9rem 0.5rem; }
    .nb-title { font-size: 1.4rem; }
  }
  @media (prefers-reduced-motion: reduce) { .nb-card { animation: none; } }
</style>

<style is:global>
  /* List rows are injected by JS and don't carry Astro's scope attribute. */
  .nb-row { display: flex; align-items: center; gap: 0.75rem; width: 100%; padding: 0.6rem 0.9rem; border-radius: 0.6rem; text-align: left; transition: background-color 0.15s; }
  .nb-row:hover { background: var(--muted); }
  .nb-row .t { flex: 1; min-width: 0; }
  .nb-row .t b { display: block; font-weight: 500; font-family: var(--font-serif); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nb-row .t small { color: var(--muted-foreground); font-size: 0.72rem; }
  .nb-dot { width: 0.5rem; height: 0.5rem; border-radius: 999px; flex-shrink: 0; }
  .nb-dot.dirty { background: var(--primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 20%, transparent); }
  .nb-dot.clean { background: var(--border); }
</style>

<script>
  import { marked } from 'marked';
  import { load, getNote, upsertNote, removeNote, isDirty, slugify, today, ago, pending, fromMarkdown, toMarkdown, type NoteDraft } from '../lib/notebook';
  import { syncNote, syncAll, deleteNoteRemote } from '../lib/sync';
  import { getToken, setToken, verifyToken, getFile, newTokenUrl, GH, actionsUrl } from '../lib/github';

  const $ = (id: string) => document.getElementById(id)!;
  const BASE = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
  const DEV_URL = '/__dev/write';
  let devMode = false;
  fetch(DEV_URL, { cache: 'no-store' }).then((r) => (devMode = r.ok)).catch(() => {});

  const sheet = $('nb-sheet'), listSheet = $('nb-list-sheet'), tk = $('tk-sheet');
  document.body.append(sheet, listSheet, tk);

  const form = $('nb-form') as HTMLFormElement;
  const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  const bodyEl = form.elements.namedItem('body') as HTMLTextAreaElement;
  const preview = $('nb-preview'), panes = $('nb-panes');
  const stateEl = $('nb-state'), savedEl = $('nb-saved'), slugEl = $('nb-slug'), countEl = $('nb-count');
  const syncBtn = $('nb-sync') as HTMLButtonElement, delBtn = $('nb-delete') as HTMLButtonElement;

  let cur: NoteDraft | null = null;
  let saveTimer = 0, previewTimer = 0;

  marked.setOptions({ gfm: true, breaks: true });

  /* ── token ──────────────────────────────────────────────────────────── */
  ($('tk-link') as HTMLAnchorElement).href = newTokenUrl();
  $('tk-repo').textContent = `${GH.owner}/${GH.repo}`;
  const tkInput = $('tk-input') as HTMLInputElement, tkMsg = $('tk-msg');
  let tkResolve: ((ok: boolean) => void) | null = null;
  function askToken(): Promise<boolean> {
    tkInput.value = ''; tkMsg.textContent = getToken() ? '已有一个令牌,粘贴新的可替换。' : '';
    tk.classList.remove('hidden'); setTimeout(() => tkInput.focus(), 50);
    return new Promise((r) => (tkResolve = r));
  }
  const closeToken = (ok: boolean) => { tk.classList.add('hidden'); tkResolve?.(ok); tkResolve = null; };
  $('tk-cancel').onclick = () => closeToken(false);
  $('tk-backdrop').onclick = () => closeToken(false);
  $('tk-clear').onclick = () => { setToken(''); tkMsg.textContent = '已清除。'; };
  $('tk-ok').onclick = async () => {
    const t = tkInput.value.trim(); if (!t) { tkMsg.textContent = '先粘贴令牌。'; return; }
    tkMsg.textContent = '验证中…';
    const v = await verifyToken(t);
    if (!v.ok) { tkMsg.textContent = '✗ ' + (v.error || '验证失败'); return; }
    setToken(t); tkMsg.textContent = `✓ 已验证,登录为 ${v.login}`; setTimeout(() => closeToken(true), 500);
  };
  tkInput.onkeydown = (e) => { if (e.key === 'Enter') $('tk-ok').click(); };
  async function ensureToken() { const t = getToken(); if (t && (await verifyToken(t)).ok) return true; return askToken(); }

  /* ── form ───────────────────────────────────────────────────────────── */
  function readForm(): NoteDraft {
    const title = el('title').value.trim();
    const date = el('date').value || today();
    const base: NoteDraft = cur || { slug: '', title: '', date, category: '', tags: [], summary: '', sticky: 0, draft: false, body: '', updatedAt: 0 };
    return {
      ...base,
      slug: base.slug || slugify(title || '未命名', date),
      title, date,
      category: el('category').value.trim(),
      tags: el('tags').value.split(/[,，]/).map((s) => s.trim()).filter(Boolean),
      summary: el('summary').value.trim(),
      sticky: Number(el('sticky').value || 0) || 0,
      draft: (el('draft') as HTMLInputElement).checked,
      body: bodyEl.value,
    };
  }
  function fillForm(n: NoteDraft | null) {
    form.reset();
    el('date').value = n?.date || today();
    if (!n) { bodyEl.value = ''; renderPreview(); return; }
    el('title').value = n.title; el('category').value = n.category; el('tags').value = n.tags.join(', ');
    el('summary').value = n.summary; el('sticky').value = String(n.sticky || 0);
    (el('draft') as HTMLInputElement).checked = n.draft; bodyEl.value = n.body;
    renderPreview();
  }
  function renderPreview() {
    const md = bodyEl.value;
    preview.innerHTML = md.trim() ? (marked.parse(md) as string) : '';
    const chars = md.replace(/\s/g, '').length;
    countEl.textContent = chars ? `${chars} 字` : '';
  }
  function refreshState() {
    if (!cur) { stateEl.textContent = '新的一页'; syncBtn.classList.add('hidden'); delBtn.classList.add('hidden'); slugEl.textContent = ''; return; }
    const dirty = isDirty(cur);
    slugEl.textContent = cur.slug + '.md';
    delBtn.classList.remove('hidden');
    if (devMode) { stateEl.textContent = '本地模式 · 保存即生效'; syncBtn.classList.add('hidden'); return; }
    syncBtn.classList.toggle('hidden', !dirty);
    if (!getToken()) { stateEl.textContent = '存在本机 · 想发布时点「同步」'; return; }
    stateEl.textContent = cur.syncedAt ? (dirty ? `有未同步的修改 · 上次同步 ${ago(cur.syncedAt)}` : `已同步 · ${ago(cur.syncedAt)}`) : '只在本地,还没同步到网站';
  }

  /* ── autosave ───────────────────────────────────────────────────────── */
  function autosave() {
    const n = readForm();
    if (!n.title && !n.body.trim()) return;
    cur = upsertNote(n);
    savedEl.textContent = `已存到本地 · ${ago(cur.updatedAt)}`; savedEl.classList.remove('hidden');
    refreshState();
    if (devMode) devWrite(cur);
  }
  form.addEventListener('input', (e) => {
    clearTimeout(saveTimer); saveTimer = window.setTimeout(autosave, 400);
    if ((e.target as HTMLElement) === bodyEl) { clearTimeout(previewTimer); previewTimer = window.setTimeout(renderPreview, 120); }
  });
  let devTimer = 0;
  function devWrite(n: NoteDraft) {
    clearTimeout(devTimer);
    devTimer = window.setTimeout(() => {
      fetch(DEV_URL, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ path: `src/content/notes/${n.slug}.md`, content: toMarkdown(n), overwrite: true }) }).catch(() => {});
    }, 800);
  }

  /* ── toolbar ────────────────────────────────────────────────────────── */
  function wrap(before: string, after = before, placeholder = '') {
    const s = bodyEl.selectionStart, e = bodyEl.selectionEnd;
    const sel = bodyEl.value.slice(s, e) || placeholder;
    bodyEl.setRangeText(before + sel + after, s, e, 'end');
    if (!bodyEl.value.slice(s, e)) bodyEl.setSelectionRange(s + before.length, s + before.length + sel.length);
    bodyEl.focus(); bodyEl.dispatchEvent(new Event('input', { bubbles: true }));
  }
  function linePrefix(prefix: string) {
    const s = bodyEl.selectionStart, e = bodyEl.selectionEnd;
    const v = bodyEl.value;
    const ls = v.lastIndexOf('\n', s - 1) + 1;
    const le = v.indexOf('\n', e); const end = le < 0 ? v.length : le;
    const lines = v.slice(ls, end).split('\n');
    const allHave = lines.every((l) => l.startsWith(prefix));
    const out = lines.map((l, i) => {
      if (allHave) return l.slice(prefix.length);
      if (prefix === '1. ') return `${i + 1}. ${l.replace(/^\d+\.\s/, '')}`;
      return prefix + l;
    }).join('\n');
    bodyEl.setRangeText(out, ls, end, 'select');
    bodyEl.focus(); bodyEl.dispatchEvent(new Event('input', { bubbles: true }));
  }
  const ACTIONS: Record<string, () => void> = {
    h2: () => linePrefix('## '), h3: () => linePrefix('### '),
    bold: () => wrap('**', '**', '加粗'), italic: () => wrap('*', '*', '斜体'), code: () => wrap('`', '`', 'code'),
    ul: () => linePrefix('- '), ol: () => linePrefix('1. '), todo: () => linePrefix('- [ ] '), quote: () => linePrefix('> '),
    link: () => wrap('[', '](https://)', '链接文字'), image: () => wrap('![', '](./images/文件名.png)', '图片说明'),
    codeblock: () => wrap('\n```\n', '\n```\n', '代码'), hr: () => wrap('\n\n---\n\n', ''),
  };
  document.querySelectorAll<HTMLButtonElement>('.nb-toolbar [data-md]').forEach((b) => (b.onclick = () => ACTIONS[b.dataset.md!]?.()));
  bodyEl.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') { e.preventDefault(); ACTIONS.bold(); }
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'i') { e.preventDefault(); ACTIONS.italic(); }
    if (e.key === 'Tab') { e.preventDefault(); wrap('  ', ''); }
  });

  /* ── view mode ──────────────────────────────────────────────────────── */
  const VIEW_KEY = 'notebook:view';
  function setView(v: string) {
    panes.dataset.view = v;
    document.querySelectorAll<HTMLButtonElement>('.nb-view').forEach((b) => b.setAttribute('aria-pressed', String(b.id === `nb-view-${v}`)));
    try { localStorage.setItem(VIEW_KEY, v); } catch {}
    if (v !== 'write') renderPreview();
  }
  for (const v of ['write', 'split', 'read']) $(`nb-view-${v}`).onclick = () => setView(v);

  /* ── open / close ───────────────────────────────────────────────────── */
  async function open(slug?: string) {
    cur = null;
    if (slug) {
      cur = getNote(slug);
      if (!cur) {
        stateEl.textContent = '正在取回这一页…';
        try {
          let md: string | null = null, sha: string | undefined;
          if (devMode) { const r = await fetch(`/__dev/read?path=src/content/notes/${encodeURIComponent(slug)}.md`); if (r.ok) md = (await r.json()).content; }
          if (md == null && getToken()) { const f = await getFile(`src/content/notes/${slug}.md`); if (f) { md = f.content; sha = f.sha; } }
          if (md == null) { const r = await fetch(`https://raw.githubusercontent.com/${GH.owner}/${GH.repo}/${GH.branch}/src/content/notes/${encodeURIComponent(slug)}.md`); if (r.ok) md = await r.text(); }
          if (md != null) { cur = fromMarkdown(slug, md, sha); upsertNote(cur); }
        } catch {}
      }
    }
    fillForm(cur);
    savedEl.textContent = cur ? `上次改动 ${ago(cur.updatedAt)}` : ''; savedEl.classList.toggle('hidden', !cur);
    refreshState();
    let v = 'write'; try { v = localStorage.getItem(VIEW_KEY) || (window.innerWidth > 900 ? 'split' : 'write'); } catch {}
    setView(v);
    sheet.classList.remove('hidden'); document.body.style.overflow = 'hidden';
    setTimeout(() => (cur?.body ? bodyEl : el('title')).focus(), 60);
  }
  function close() { clearTimeout(saveTimer); autosave(); sheet.classList.add('hidden'); document.body.style.overflow = ''; window.dispatchEvent(new CustomEvent('notebook:change')); }
  $('nb-close').onclick = close;
  document.addEventListener('keydown', (e) => {
    if (!tk.classList.contains('hidden')) { if (e.key === 'Escape') closeToken(false); return; }
    if (!listSheet.classList.contains('hidden')) { if (e.key === 'Escape') closeList(); return; }
    if (sheet.classList.contains('hidden')) return;
    if (e.key === 'Escape') close();
    if ((e.ctrlKey || e.metaKey) && e.key === 's') { e.preventDefault(); clearTimeout(saveTimer); autosave(); savedEl.textContent = '已存到本地 ✓'; }
  });

  /* ── sync one ───────────────────────────────────────────────────────── */
  syncBtn.onclick = async () => {
    clearTimeout(saveTimer); autosave(); if (!cur) return;
    if (cur.draft && !confirm('这一页勾了「草稿(不公开)」。\n同步上去也不会出现在网站上,只是备份到仓库。\n\n要不要先取消草稿再同步?\n\n「确定」= 保持草稿、只备份   「取消」= 我先去掉草稿勾')) return;
    if (!(await ensureToken())) return;
    syncBtn.disabled = true; stateEl.textContent = '正在同步…';
    try {
      await syncNote(cur); cur = getNote(cur.slug); refreshState();
      stateEl.textContent = cur?.draft ? '已备份 ✓(草稿,网站上不显示)' : '已同步 ✓ 约 1~2 分钟后网站更新';
    }
    catch (e: any) { stateEl.textContent = '✗ ' + (e?.message || e); }
    finally { syncBtn.disabled = false; }
  };

  /* ── delete ─────────────────────────────────────────────────────────── */
  delBtn.onclick = async () => {
    if (!cur) return;
    const wasSynced = Boolean(cur.syncedAt || cur.sha);
    if (!confirm(`撕掉这一页「${cur.title || cur.slug}」?${wasSynced ? '\n网站上的版本会在下次同步时一并删除。' : ''}`)) return;
    const slug = cur.slug;
    removeNote(slug);
    if (devMode) { fetch('/__dev/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ path: `src/content/notes/${slug}.md` }) }).catch(() => {}); }
    else if (wasSynced && getToken()) { try { await deleteNoteRemote(slug); } catch {} }
    cur = null; sheet.classList.add('hidden'); document.body.style.overflow = '';
    if (location.pathname.includes(`/notes/${encodeURIComponent(slug)}`) || location.pathname.includes(`/notes/${slug}`)) location.href = BASE + '/';
    else window.dispatchEvent(new CustomEvent('notebook:change'));
  };

  /* ── list ───────────────────────────────────────────────────────────── */
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  function renderList() {
    const nb = load();
    const notes = Object.values(nb.notes).sort((a, b) => b.updatedAt - a.updatedAt);
    const p = pending();
    $('nb-list-sub').textContent = notes.length ? `${notes.length} 页 · ${p.count ? p.count + ' 项待同步' : '全部已同步'}` : '还是空的';
    ($('nb-sync-all') as HTMLButtonElement).classList.toggle('hidden', devMode || p.count === 0);
    const body = $('nb-list-body');
    body.innerHTML = notes.length ? '' : '<p class="px-4 py-8 text-center text-sm text-muted-foreground">翻开新的一页开始写吧。</p>';
    for (const n of notes) {
      const dirty = isDirty(n);
      const row = document.createElement('button');
      row.type = 'button'; row.className = 'nb-row';
      row.innerHTML = `<span class="nb-dot ${dirty ? 'dirty' : 'clean'}" title="${dirty ? '有未同步的修改' : '已同步'}"></span><span class="t"><b>${esc(n.title || '(无标题)')}</b><small>${n.date} · 改于 ${ago(n.updatedAt)}${n.draft ? ' · 草稿' : ''}</small></span>`;
      row.onclick = () => { closeList(); open(n.slug); };
      body.appendChild(row);
    }
  }
  function openList() { renderList(); listSheet.classList.remove('hidden'); }
  function closeList() { listSheet.classList.add('hidden'); }
  $('nb-list').onclick = () => { clearTimeout(saveTimer); autosave(); openList(); };
  $('nb-list-close').onclick = closeList; $('nb-list-backdrop').onclick = closeList;
  $('nb-new').onclick = () => { closeList(); open(); };

  async function doSyncAll(): Promise<{ ok: boolean; pushed: number; deleted: number; errors: string[] } | null> {
    if (!(await ensureToken())) return null;
    const r = await syncAll();
    window.dispatchEvent(new CustomEvent('notebook:change'));
    return r;
  }
  $('nb-sync-all').onclick = async () => {
    const b = $('nb-sync-all') as HTMLButtonElement; b.disabled = true; b.textContent = '同步中…';
    const r = await doSyncAll();
    b.disabled = false; b.textContent = '同步全部';
    renderList();
    if (r) $('nb-list-sub').textContent = r.ok ? `已同步 ${r.pushed} 项${r.deleted ? `,删除 ${r.deleted} 项` : ''} · 约 1~2 分钟后网站更新` : '部分失败:' + r.errors.join(';');
    if (r?.ok && r.pushed + r.deleted > 0) setTimeout(() => window.open(actionsUrl(), '_blank'), 600);
  };

  (window as any).__notebook = { open, openList, syncAll: doSyncAll, pendingCount: () => pending().count };
</script>
