---
interface Props {
  current: number;
  total: number;
  /** Build the href for a given page number. Page 1 maps to the base path. */
  href: (page: number) => string;
}
const { current, total, href } = Astro.props;
---

{
  total > 1 && (
    <nav class="mt-8 flex items-center justify-center gap-2 text-sm" aria-label="分页">
      {current > 1 ? (
        <a href={href(current - 1)} class="chip">
          ← 上一页
        </a>
      ) : (
        <span class="chip opacity-40">← 上一页</span>
      )}
      <span class="px-2 text-muted-foreground">
        {current} / {total}
      </span>
      {current < total ? (
        <a href={href(current + 1)} class="chip">
          下一页 →
        </a>
      ) : (
        <span class="chip opacity-40">下一页 →</span>
      )}
    </nav>
  )
}
