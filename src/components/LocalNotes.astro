---
// Pages that exist only in this browser (not yet synced) — shown at the top of
// the homepage list so what you just wrote is visible immediately. Rendered
// client-side from localStorage; empty for visitors.
---

<div id="local-notes" class="hidden">
  <p class="local-notes-head">
    <span>本机上的页</span>
    <button type="button" id="local-sync-all" class="chip hidden">同步全部到网站</button>
  </p>
  <div id="local-notes-list"></div>
</div>

<style is:global>
  .local-notes-head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.4rem 0.25rem 0.2rem; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-foreground); }
  .local-row { display: grid; grid-template-columns: 5.75rem minmax(0, 1fr) auto; align-items: center; gap: 1rem; width: 100%; padding: 0.9rem 0.25rem; border-bottom: 1px solid var(--border); text-align: left; transition: background-color 0.15s; }
  .local-row:hover { background: color-mix(in srgb, var(--muted) 50%, transparent); }
  .local-thumb { width: 5.75rem; height: 3.9rem; border-radius: 0.4rem; background: repeating-linear-gradient(135deg, var(--muted) 0 6px, color-mix(in srgb, var(--muted) 60%, var(--card)) 6px 12px); display: grid; place-items: center; }
  .local-thumb svg { width: 1.5rem; height: 1.5rem; color: var(--muted-foreground); opacity: 0.7; }
  .local-title { font-family: var(--font-serif); font-size: 0.98rem; font-weight: 500; color: var(--foreground); line-height: 1.45; }
  .local-row:hover .local-title { color: var(--primary); }
  .local-sum { margin-top: 0.25rem; font-size: 0.78rem; color: var(--muted-foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .local-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.25rem; }
  .local-date { font-size: 0.74rem; color: var(--muted-foreground); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .local-badge { font-size: 0.65rem; padding: 0.1rem 0.5rem; border-radius: 999px; background: color-mix(in srgb, var(--primary) 14%, transparent); color: var(--primary); white-space: nowrap; }
  .local-badge.synced { background: var(--muted); color: var(--muted-foreground); }
  .local-badge.draft { background: color-mix(in srgb, #c9a040 18%, transparent); color: #8a6a14; }
  @media (max-width: 640px) { .local-row { grid-template-columns: 5rem minmax(0, 1fr); } .local-thumb { width: 5rem; height: 3.5rem; } .local-right { grid-column: 2; flex-direction: row; } }
</style>

<script>
  import { load, isDirty, pending } from '../lib/notebook';

  const root = document.getElementById('local-notes')!;
  const list = document.getElementById('local-notes-list')!;
  const syncBtn = document.getElementById('local-sync-all') as HTMLButtonElement;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  function render() {
    const notes = Object.values(load().notes).sort((a, b) => b.updatedAt - a.updatedAt);
    // Keep showing anything that is NOT visible on the public site yet:
    // never synced, changed since sync, or synced but still marked as draft
    // (the build skips drafts, so it won't appear in the list below).
    const local = notes.filter((n) => isDirty(n) || !n.syncedAt || n.draft);
    root.classList.toggle('hidden', local.length === 0);
    syncBtn.classList.toggle('hidden', pending().count === 0);
    list.innerHTML = '';
    for (const n of local) {
      const row = document.createElement('button');
      row.type = 'button'; row.className = 'local-row';
      const firstLine = (n.summary || n.body.split('\n').find((l) => l.trim() && !l.startsWith('#')) || '').replace(/[#*`>_\-\[\]]/g, '').trim();
      const dirty = isDirty(n);
      let badge: string, cls = '';
      if (n.draft) { badge = n.syncedAt ? '草稿 · 已同步但不公开' : '草稿 · 还没同步'; cls = 'draft'; }
      else if (!n.syncedAt) badge = '还没同步';
      else if (dirty) badge = '有改动未同步';
      else { badge = '已同步'; cls = 'synced'; }
      row.innerHTML = `
        <span class="local-thumb"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></span>
        <span class="min-w-0"><span class="local-title">${esc(n.title || '(无标题)')}</span>${firstLine ? `<span class="local-sum">${esc(firstLine)}</span>` : ''}</span>
        <span class="local-right"><span class="local-date">${n.date}</span><span class="local-badge ${cls}">${badge}</span></span>`;
      row.onclick = () => (window as any).__notebook?.open(n.slug);
      list.appendChild(row);
    }
  }
  syncBtn.onclick = async () => {
    syncBtn.disabled = true; syncBtn.textContent = '同步中…';
    const r = await (window as any).__notebook?.syncAll?.();
    syncBtn.disabled = false; syncBtn.textContent = r?.ok ? '已同步 ✓ 约 1~2 分钟后更新' : '同步全部到网站';
    render();
  };
  window.addEventListener('notebook:change', render);
  window.addEventListener('storage', render);
  render();
</script>
