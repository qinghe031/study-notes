---
// "写笔记 / 编辑 / 删除" — one centered card editor shared across the site.
// Backends: dev writer (npm run dev, instant) or GitHub (hosted, via token).
// Hidden for visitors; appears when a backend is reachable.
import { formatDate, getNotes, getCategories } from '../lib/content';
const today = formatDate(new Date());
const categories = getCategories(await getNotes()).map((c) => c.name);
---

<button id="wn-open" type="button" class="wn-trigger chip hidden items-center gap-1.5 !px-3 !py-1.5 !text-sm">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
  写笔记
</button>

<!-- ═══ Editor card ═══════════════════════════════════════════════════════ -->
<div id="wn-sheet" class="fixed inset-0 z-[75] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-label="写笔记">
  <div id="wn-backdrop" class="absolute inset-0 bg-[color-mix(in_srgb,var(--background)_70%,transparent)] backdrop-blur-md"></div>

  <div class="wn-card card relative flex max-h-[92vh] w-full max-w-3xl flex-col overflow-hidden shadow-2xl">
    <!-- header -->
    <header class="flex items-center justify-between gap-3 border-b border-border px-6 py-4">
      <div class="flex items-center gap-3">
        <span class="grid h-9 w-9 place-items-center rounded-xl" style="background: color-mix(in srgb, var(--primary) 14%, transparent)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        </span>
        <div>
          <h2 id="wn-title" class="text-base font-semibold leading-tight">写笔记</h2>
          <p id="wn-sub" class="text-xs text-muted-foreground">本地保存,立即生效</p>
        </div>
      </div>
      <button id="wn-close" type="button" aria-label="关闭" class="rounded-lg p-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </header>

    <!-- body -->
    <form id="wn-form" class="min-h-0 flex-1 overflow-y-auto px-6 py-5" autocomplete="off">
      <input name="title" required placeholder="给这篇笔记起个标题" class="wn-title" />

      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        <label class="wn-field">
          <span>日期</span>
          <input name="date" type="date" value={today} />
        </label>
        <label class="wn-field">
          <span>分类</span>
          <input name="category" placeholder="算法" list="wn-cats" />
        </label>
        <label class="wn-field">
          <span>标签</span>
          <input name="tags" placeholder="动态规划, 刷题" />
        </label>
      </div>

      <label class="wn-field mt-3">
        <span>摘要 <em class="font-normal opacity-60">可空,显示在卡片上</em></span>
        <input name="summary" placeholder="一句话说明这篇讲什么" />
      </label>

      <label class="wn-field mt-3">
        <span>正文 <em class="font-normal opacity-60">Markdown</em></span>
        <textarea name="body" rows="12" placeholder="## 第一节&#10;&#10;支持代码块、$公式$、表格,图片写 ./images/xxx.png"></textarea>
      </label>

      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-muted-foreground">
        <label class="inline-flex cursor-pointer items-center gap-2"><input name="draft" type="checkbox" class="wn-check" /> 草稿(不发布)</label>
        <label class="inline-flex items-center gap-2">置顶 <input name="sticky" type="number" min="0" value="0" class="wn-mini" /></label>
        <span id="wn-path" class="ml-auto truncate font-mono text-[11px] opacity-70"></span>
      </div>
    </form>

    <!-- footer -->
    <footer class="flex items-center justify-between gap-3 border-t border-border px-6 py-4">
      <div class="flex items-center gap-2">
        <button id="wn-delete" type="button" class="wn-ghost hidden text-[var(--destructive,#c7303c)]">删除这篇</button>
        <button id="wn-token-btn" type="button" class="wn-ghost">GitHub 令牌</button>
      </div>
      <div class="flex items-center gap-3">
        <span id="wn-msg" class="text-xs text-muted-foreground"></span>
        <button id="wn-save" type="button" class="wn-primary">保存</button>
      </div>
    </footer>
  </div>
</div>

<!-- ═══ Token card ════════════════════════════════════════════════════════ -->
<div id="tk-sheet" class="fixed inset-0 z-[80] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-label="设置 GitHub 令牌">
  <div id="tk-backdrop" class="absolute inset-0 bg-[color-mix(in_srgb,var(--background)_70%,transparent)] backdrop-blur-md"></div>
  <div class="card relative w-full max-w-md overflow-hidden shadow-2xl">
    <header class="border-b border-border px-6 py-4">
      <h2 class="text-base font-semibold">在线保存需要一个 GitHub 令牌</h2>
      <p class="mt-1 text-xs text-muted-foreground">只需设置一次,只存在你这台电脑的浏览器里。</p>
    </header>
    <div class="space-y-4 px-6 py-5 text-sm">
      <ol class="space-y-2.5 text-muted-foreground">
        <li class="flex gap-3"><span class="wn-step">1</span><span>点下面的按钮打开 GitHub 生成页(新标签页)。</span></li>
        <li class="flex gap-3"><span class="wn-step">2</span><span><b class="text-foreground">Repository access</b> 选 Only select repositories → 勾 <code id="tk-repo" class="rounded bg-muted px-1">study-notes</code></span></li>
        <li class="flex gap-3"><span class="wn-step">3</span><span><b class="text-foreground">Permissions → Contents</b> 选 <b class="text-foreground">Read and write</b>,然后 Generate token</span></li>
        <li class="flex gap-3"><span class="wn-step">4</span><span>复制令牌,回到这里粘贴。</span></li>
      </ol>
      <a id="tk-link" href="#" target="_blank" rel="noopener" class="wn-primary inline-flex w-full justify-center gap-2">
        打开 GitHub 令牌生成页
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
      </a>
      <label class="wn-field">
        <span>粘贴令牌</span>
        <input id="tk-input" type="password" placeholder="github_pat_… 或 ghp_…" autocomplete="off" spellcheck="false" />
      </label>
      <p id="tk-msg" class="min-h-[1.2em] text-xs text-muted-foreground"></p>
    </div>
    <footer class="flex items-center justify-between border-t border-border px-6 py-4">
      <button id="tk-clear" type="button" class="wn-ghost">清除已保存的令牌</button>
      <div class="flex gap-2">
        <button id="tk-cancel" type="button" class="wn-ghost">取消</button>
        <button id="tk-ok" type="button" class="wn-primary">验证并保存</button>
      </div>
    </footer>
  </div>
</div>

<datalist id="wn-cats">
  {categories.map((c) => <option value={c} />)}
</datalist>

<style>
  .wn-trigger:not(.hidden) { display: inline-flex; }
  #wn-sheet:not(.hidden), #tk-sheet:not(.hidden) { display: flex; }

  .wn-card { animation: wn-in 0.28s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes wn-in { from { opacity: 0; transform: translateY(14px) scale(0.98); } to { opacity: 1; transform: none; } }

  .wn-title {
    width: 100%;
    padding: 0.4rem 0;
    border: 0;
    border-bottom: 2px solid var(--border);
    background: transparent;
    color: var(--foreground);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    outline: none;
    transition: border-color 0.2s;
  }
  .wn-title:focus { border-bottom-color: var(--primary); }
  .wn-title::placeholder { color: var(--muted-foreground); opacity: 0.6; font-weight: 500; }

  .wn-field { display: flex; flex-direction: column; gap: 0.35rem; }
  .wn-field > span { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted-foreground); }
  .wn-field > span em { text-transform: none; letter-spacing: 0; font-style: normal; }
  .wn-field input, .wn-field textarea, .wn-mini {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--background);
    color: var(--foreground);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .wn-field textarea { font-family: var(--font-mono); font-size: 0.85rem; line-height: 1.7; resize: vertical; min-height: 14rem; }
  .wn-field input:focus, .wn-field textarea:focus, .wn-mini:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 18%, transparent);
  }
  .wn-field input::placeholder, .wn-field textarea::placeholder { color: var(--muted-foreground); opacity: 0.55; }
  .wn-mini { width: 4rem; padding: 0.3rem 0.5rem; text-align: center; }
  .wn-check { accent-color: var(--primary); width: 0.95rem; height: 0.95rem; }

  .wn-primary {
    padding: 0.55rem 1.1rem;
    border-radius: 0.75rem;
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: 0.875rem;
    font-weight: 600;
    transition: opacity 0.15s, transform 0.15s;
  }
  .wn-primary:hover { opacity: 0.92; }
  .wn-primary:active { transform: scale(0.98); }
  .wn-primary:disabled { opacity: 0.5; cursor: wait; }
  .wn-ghost {
    padding: 0.45rem 0.7rem;
    border-radius: 0.6rem;
    font-size: 0.8rem;
    color: var(--muted-foreground);
    transition: background-color 0.15s, color 0.15s;
  }
  .wn-ghost:hover { background: var(--muted); color: var(--foreground); }
  .wn-ghost.hidden { display: none; }

  .wn-step {
    display: grid; place-items: center; flex-shrink: 0;
    width: 1.4rem; height: 1.4rem; border-radius: 999px;
    background: color-mix(in srgb, var(--primary) 16%, transparent);
    color: var(--primary); font-size: 0.7rem; font-weight: 700;
  }
  @media (prefers-reduced-motion: reduce) { .wn-card { animation: none; } }
</style>

<script>
  import { getToken, setToken, verifyToken, getFile, putFile, deleteFile, actionsUrl, newTokenUrl, GH } from '../lib/github';
  const BASE = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

  const DEV_URL = '/__dev/write';
  const $ = (id: string) => document.getElementById(id)!;
  const openBtn = $('wn-open') as HTMLButtonElement;
  const sheet = $('wn-sheet');
  const form = $('wn-form') as HTMLFormElement;
  const saveBtn = $('wn-save') as HTMLButtonElement;
  const delBtn = $('wn-delete') as HTMLButtonElement;
  const msg = $('wn-msg');
  const pathEl = $('wn-path');
  const titleEl = $('wn-title');
  const subEl = $('wn-sub');
  const DRAFT_KEY = 'write-note:draft';

  type Mode = 'dev' | 'gh' | 'none';
  let mode: Mode = 'none';
  let editingPath: string | null = null;
  let editingSha: string | null = null;

  /* ── backend detection ──────────────────────────────────────────────── */
  (async () => {
    try { if ((await fetch(DEV_URL, { cache: 'no-store' })).ok) mode = 'dev'; } catch {}
    if (mode === 'none' && (getToken() || location.protocol === 'https:')) mode = 'gh';
    if (mode !== 'none') {
      openBtn.classList.remove('hidden');
      document.querySelectorAll<HTMLElement>('.wn-open-alias').forEach((e) => e.classList.remove('hidden'));
    }
  })();

  /* ── token card ─────────────────────────────────────────────────────── */
  const tk = $('tk-sheet');
  const tkInput = $('tk-input') as HTMLInputElement;
  const tkMsg = $('tk-msg');
  ($('tk-link') as HTMLAnchorElement).href = newTokenUrl();
  $('tk-repo').textContent = `${GH.owner}/${GH.repo}`;
  let tkResolve: ((ok: boolean) => void) | null = null;

  function askToken(): Promise<boolean> {
    tkInput.value = '';
    tkMsg.textContent = getToken() ? '已有一个令牌,粘贴新的可替换。' : '';
    tk.classList.remove('hidden');
    setTimeout(() => tkInput.focus(), 50);
    return new Promise((res) => (tkResolve = res));
  }
  function closeToken(ok: boolean) { tk.classList.add('hidden'); tkResolve?.(ok); tkResolve = null; }

  $('tk-cancel').addEventListener('click', () => closeToken(false));
  $('tk-backdrop').addEventListener('click', () => closeToken(false));
  $('tk-clear').addEventListener('click', () => { setToken(''); tkMsg.textContent = '已清除。'; });
  $('tk-ok').addEventListener('click', async () => {
    const t = tkInput.value.trim();
    if (!t) { tkMsg.textContent = '先粘贴令牌。'; return; }
    tkMsg.textContent = '验证中…';
    const v = await verifyToken(t);
    if (!v.ok) { tkMsg.textContent = '✗ ' + (v.error || '验证失败'); return; }
    setToken(t);
    tkMsg.textContent = `✓ 已验证,登录为 ${v.login}`;
    setTimeout(() => closeToken(true), 500);
  });
  tkInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') $('tk-ok').click(); });

  async function ensureToken(): Promise<boolean> {
    const t = getToken();
    if (t) { const v = await verifyToken(t); if (v.ok) return true; setMsg('令牌失效:' + v.error); }
    return askToken();
  }

  /* ── form helpers ───────────────────────────────────────────────────── */
  const safeName = (s: string) => s.replace(/[\\/:*?"<>|\s]+/g, '-').replace(/^-+|-+$/g, '');
  const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  const setMsg = (t: string) => { msg.textContent = t; };

  function read() {
    const f = new FormData(form);
    return {
      title: String(f.get('title') || '').trim(),
      date: String(f.get('date') || ''),
      category: String(f.get('category') || '').trim() || '未分类',
      tags: String(f.get('tags') || '').split(/[,，]/).map((s) => s.trim()).filter(Boolean),
      summary: String(f.get('summary') || '').trim(),
      draft: f.get('draft') === 'on',
      sticky: Number(f.get('sticky') || 0) || 0,
      body: String(f.get('body') || ''),
    };
  }
  function compose() {
    const d = read();
    const content = [
      '---', `title: ${d.title}`, `date: ${d.date}`, `category: ${d.category}`, `tags: [${d.tags.join(', ')}]`,
      d.summary ? `summary: ${d.summary}` : null, `sticky: ${d.sticky}`, `draft: ${d.draft}`, '---', '', d.body.trim(), '',
    ].filter((l) => l !== null).join('\n');
    const slug = editingPath ? editingPath.replace(/^src\/content\/notes\//, '').replace(/\.md$/, '') : `${d.date}-${safeName(d.title) || '未命名'}`;
    return { path: editingPath || `src/content/notes/${slug}.md`, content, slug };
  }
  function parseFrontmatter(src: string): Record<string, string> {
    const m = src.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
    if (!m) return { body: src };
    const fm: Record<string, string> = {};
    for (const line of m[1].split('\n')) {
      const kv = line.match(/^(\w+):\s*(.*)$/);
      if (kv) fm[kv[1]] = kv[1] === 'tags' ? kv[2].trim().replace(/^\[|\]$/g, '') : kv[2].trim();
    }
    fm.body = m[2].replace(/^\n+/, '');
    return fm;
  }
  function updatePath() { pathEl.textContent = compose().path.replace('src/content/notes/', ''); }
  function persistDraft() { if (!editingPath) try { localStorage.setItem(DRAFT_KEY, JSON.stringify(read())); } catch {} }

  /* ── open / close ───────────────────────────────────────────────────── */
  function openEditor(prefill?: { path: string; content: string; sha?: string }) {
    editingPath = prefill?.path ?? null;
    editingSha = prefill?.sha ?? null;
    titleEl.textContent = prefill ? '编辑笔记' : '写笔记';
    subEl.textContent = mode === 'dev' ? '本地保存,立即生效' : '提交到 GitHub,约 1~2 分钟后生效';
    saveBtn.textContent = prefill ? '保存修改' : '保存';
    delBtn.classList.toggle('hidden', !prefill);
    setMsg('');
    form.reset();
    el('date').value = new Date().toISOString().slice(0, 10);
    if (prefill) {
      const fm = parseFrontmatter(prefill.content);
      el('title').value = fm.title || '';
      el('date').value = fm.date || el('date').value;
      el('category').value = fm.category || '';
      el('tags').value = fm.tags || '';
      el('summary').value = fm.summary || '';
      el('sticky').value = fm.sticky || '0';
      (el('draft') as HTMLInputElement).checked = fm.draft === 'true';
      (form.elements.namedItem('body') as HTMLTextAreaElement).value = fm.body || '';
    } else {
      try {
        const d = JSON.parse(localStorage.getItem(DRAFT_KEY) || 'null');
        if (d) { el('title').value = d.title || ''; el('category').value = d.category || ''; el('tags').value = (d.tags || []).join(', '); el('summary').value = d.summary || ''; (form.elements.namedItem('body') as HTMLTextAreaElement).value = d.body || ''; }
      } catch {}
    }
    updatePath();
    sheet.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    setTimeout(() => el('title').focus(), 50);
  }
  function hide() { sheet.classList.add('hidden'); document.body.style.overflow = ''; }

  openBtn.addEventListener('click', () => openEditor());
  document.querySelectorAll<HTMLElement>('.wn-open-alias').forEach((e) => e.addEventListener('click', () => openEditor()));
  $('wn-close').addEventListener('click', hide);
  $('wn-backdrop').addEventListener('click', hide);
  $('wn-token-btn').addEventListener('click', () => askToken());
  document.addEventListener('keydown', (e) => {
    if (!tk.classList.contains('hidden')) { if (e.key === 'Escape') closeToken(false); return; }
    if (sheet.classList.contains('hidden')) return;
    if (e.key === 'Escape') hide();
    if ((e.ctrlKey || e.metaKey) && e.key === 's') { e.preventDefault(); save(); }
  });
  form.addEventListener('input', () => { updatePath(); persistDraft(); });

  /* ── save ───────────────────────────────────────────────────────────── */
  async function devPost(body: object) {
    const r = await fetch(DEV_URL, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    return { status: r.status, json: await r.json() };
  }
  async function save() {
    const d = read();
    if (!d.title) { setMsg('先写个标题'); el('title').focus(); return; }
    const { path, content, slug } = compose();
    saveBtn.disabled = true;
    try {
      if (mode === 'dev') {
        setMsg('保存中…');
        let r = await devPost({ path, content, overwrite: !!editingPath });
        if (r.status === 409) {
          if (!confirm('同名笔记已存在,覆盖吗?')) { saveBtn.disabled = false; setMsg(''); return; }
          r = await devPost({ path, content, overwrite: true });
        }
        if (!r.json.ok) throw new Error(r.json.error || '保存失败');
        try { localStorage.removeItem(DRAFT_KEY); } catch {}
        setMsg('已保存 ✓');
        setTimeout(() => (location.href = `${BASE}/notes/${slug}/`), 400);
        return;
      }
      if (!(await ensureToken())) { saveBtn.disabled = false; return; }
      setMsg('提交中…');
      let sha = editingSha || undefined;
      if (editingPath && !sha) sha = (await getFile(path))?.sha;
      await putFile(path, content, editingPath ? `更新笔记:${slug}` : `新增笔记:${slug}`, sha);
      try { localStorage.removeItem(DRAFT_KEY); } catch {}
      setMsg('已提交 ✓ 约 1~2 分钟后生效');
      saveBtn.textContent = '已提交';
      setTimeout(() => { hide(); window.open(actionsUrl(), '_blank'); }, 900);
    } catch (e: any) {
      setMsg('✗ ' + (e?.message || e));
      saveBtn.disabled = false;
    }
  }
  saveBtn.addEventListener('click', save);

  /* ── delete ─────────────────────────────────────────────────────────── */
  delBtn.addEventListener('click', async () => {
    if (!editingPath) return;
    const slug = editingPath.replace(/^src\/content\/notes\//, '').replace(/\.md$/, '');
    if (!confirm(`确定删除「${el('title').value || slug}」?此操作不可撤销。`)) return;
    delBtn.disabled = true;
    try {
      if (mode === 'dev') {
        const r = await fetch('/__dev/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ path: editingPath }) });
        const j = await r.json();
        if (!j.ok) throw new Error(j.error || '删除失败');
        setMsg('已删除 ✓');
        setTimeout(() => (location.href = BASE + '/'), 400);
        return;
      }
      if (!(await ensureToken())) { delBtn.disabled = false; return; }
      setMsg('删除中…');
      const sha = editingSha || (await getFile(editingPath))?.sha;
      if (!sha) throw new Error('仓库里没有这个文件');
      await deleteFile(editingPath, sha, `删除笔记:${slug}`);
      setMsg('已删除 ✓ 约 1~2 分钟后生效');
      setTimeout(() => { hide(); location.href = BASE + '/'; }, 900);
    } catch (e: any) {
      setMsg('✗ ' + (e?.message || e));
      delBtn.disabled = false;
    }
  });

  (window as any).__openNoteEditor = openEditor;
</script>
