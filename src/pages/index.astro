---
import BaseLayout from '../layouts/BaseLayout.astro';
import StickyNotes from '../components/StickyNotes.astro';
import Countdowns from '../components/Countdowns.astro';
import PostRow from '../components/PostRow.astro';
import SidebarProfile from '../components/SidebarProfile.astro';
import FocusToday from '../components/FocusToday.astro';
import LocalNotes from '../components/LocalNotes.astro';
import Pagination from '../components/Pagination.astro';
import { withBase } from '../lib/url';
import { getNotes } from '../lib/content';
import { SITE } from '../lib/site';

const notes = await getNotes();
const page = notes.slice(0, SITE.postsPerPage);
const total = Math.max(1, Math.ceil(notes.length / SITE.postsPerPage));
---

<BaseLayout>
  {/* ── top row: sticky · countdown ── */}
  <section class="grid gap-5 pt-2 md:grid-cols-2 lg:grid-cols-[1.15fr_1fr]">
    <StickyNotes />
    <Countdowns />
  </section>

  {/* ── main: posts · sidebar ── */}
  <div class="mt-8 grid gap-5 lg:grid-cols-[minmax(0,1fr)_15.5rem]">
    <section class="card reveal px-5 pb-2 pt-4">
      <header class="mb-2 flex items-center justify-between">
        <h2 class="serif text-base">我的博客</h2>
        <div class="flex items-center gap-3">
          <button type="button" class="nb-open chip hidden">✎ 写一页</button>
          <a href={withBase('/archive/')} class="text-xs text-muted-foreground hover:text-foreground">查看更多 →</a>
        </div>
      </header>
      <FocusToday />
      <LocalNotes />
      {
        page.length === 0 ? (
          <p class="py-10 text-center text-sm text-muted-foreground">还是空的。点「写一页」开始。</p>
        ) : (
          page.map((n, i) => <PostRow note={n} index={i} />)
        )
      }
      <Pagination current={1} total={total} href={(p) => (p === 1 ? '/' : `/page/${p}/`)} />
    </section>

    <SidebarProfile />
  </div>
</BaseLayout>
