---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { getNotes, noteHref, formatDate } from '../lib/content';

// Build the search index at build time and inline it into the page, so search
// works both on a hosted site and when opening dist-local/ via file://
// (where fetch() is blocked by the browser).
const notes = await getNotes();
const index = notes.map((n) => ({
  t: n.data.title,
  u: noteHref(n),
  d: formatDate(n.data.date),
  c: n.data.category,
  g: n.data.tags,
  s: n.data.summary || '',
  // Strip markdown syntax roughly; keep enough to match on.
  b: (n.body || '')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/[#>*_`\[\]()!|~-]/g, ' ')
    .replace(/\s+/g, ' ')
    .slice(0, 4000),
}));
---

<BaseLayout title="搜索">
  <Hero eyebrow="Search" title="搜索" subtitle="在所有笔记的标题、摘要、标签和正文中查找。" />

  <div class="mx-auto max-w-3xl">
    <label class="card flex items-center gap-3 px-4 py-3">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input
        id="search-input"
        type="search"
        placeholder="输入关键词,支持多个词用空格隔开…"
        autocomplete="off"
        autofocus
        class="w-full bg-transparent text-base outline-none placeholder:text-muted-foreground"
      />
    </label>
    <p id="search-status" class="mt-3 text-sm text-muted-foreground">共 {notes.length} 篇笔记可搜索。</p>
    <div id="search-results" class="mt-4 space-y-3"></div>
  </div>

  <script is:inline set:html={`window.__SEARCH_INDEX__ = ${JSON.stringify(index)};`} />

  <script>
    type Item = { t: string; u: string; d: string; c: string; g: string[]; s: string; b: string };
    const INDEX: Item[] = (window as any).__SEARCH_INDEX__ || [];
    const input = document.getElementById('search-input') as HTMLInputElement;
    const status = document.getElementById('search-status')!;
    const results = document.getElementById('search-results')!;

    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    function highlight(text: string, terms: string[]) {
      let out = esc(text);
      for (const t of terms) {
        const re = new RegExp(t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
        out = out.replace(re, (m) => `<mark class="rounded bg-primary/20 px-0.5 text-foreground">${m}</mark>`);
      }
      return out;
    }

    function snippet(body: string, terms: string[]) {
      const lower = body.toLowerCase();
      let pos = -1;
      for (const t of terms) {
        const i = lower.indexOf(t.toLowerCase());
        if (i >= 0 && (pos < 0 || i < pos)) pos = i;
      }
      const start = Math.max(0, pos - 40);
      const s = body.slice(start, start + 140);
      return (start > 0 ? '…' : '') + s + (start + 140 < body.length ? '…' : '');
    }

    function run() {
      const q = input.value.trim();
      const terms = q.split(/\s+/).filter(Boolean);
      results.innerHTML = '';
      if (!terms.length) {
        status.textContent = `共 ${INDEX.length} 篇笔记可搜索。`;
        return;
      }
      const scored = INDEX.map((it) => {
        let score = 0;
        for (const t of terms) {
          const tl = t.toLowerCase();
          if (it.t.toLowerCase().includes(tl)) score += 10;
          if (it.g.some((g) => g.toLowerCase().includes(tl))) score += 6;
          if (it.c.toLowerCase().includes(tl)) score += 4;
          if (it.s.toLowerCase().includes(tl)) score += 3;
          if (it.b.toLowerCase().includes(tl)) score += 1;
        }
        return { it, score };
      })
        .filter((x) => x.score > 0)
        .sort((a, b) => b.score - a.score);

      status.textContent = scored.length ? `找到 ${scored.length} 条结果` : '没有找到匹配的笔记。';
      for (const { it } of scored.slice(0, 50)) {
        const a = document.createElement('a');
        a.href = it.u;
        a.className = 'card card-hover block p-4';
        a.innerHTML = `
          <div class="mb-1 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
            <span class="rounded-md bg-muted px-2 py-0.5">${esc(it.c)}</span>
            <span>${esc(it.d)}</span>
          </div>
          <h3 class="font-semibold">${highlight(it.t, terms)}</h3>
          <p class="mt-1 text-sm text-muted-foreground">${highlight(snippet(it.s || it.b, terms), terms)}</p>
          ${it.g.length ? `<div class="mt-2 flex flex-wrap gap-1">${it.g.map((g) => `<span class="chip">#${highlight(g, terms)}</span>`).join('')}</div>` : ''}
        `;
        results.appendChild(a);
      }
    }

    input.addEventListener('input', run);
    const initial = new URLSearchParams(location.search).get('q');
    if (initial) {
      input.value = initial;
      run();
    }
  </script>
</BaseLayout>
